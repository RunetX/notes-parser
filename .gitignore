# --- Проект: секреты, состояние, legacy ---
# Вывод tools/export_sessions.py — живые куки пользователей
sessions_export.json
# SQLite-база lovegw
data/
# Собранный бинарник lovegw (якорные пути: паттерн без слэша матчил бы
# и каталог go/cmd/lovegw с исходниками)
/go/lovegw.exe
/go/lovegw
# Артефакт сборки: Go оставляет его, если пересобрать при запущенном демоне
/go/lovegw.exe~
# Наблюдатель за модерацией: отдельный бинарник (чтобы start/stop.bat не путали
# его с демоном по имени процесса) и его лог
/go/modwatch.exe
/go/modwatch.exe~
/go/modwatch.log
# Лог демона
/go/run.log
# Конфиги с токенами ботов (шаблоны *.example.json — можно коммитить)
config.json
config.*.json
!config.example.json
ryumkin.json
# Env-файлы деплоя: compose и runbook велят класть secrets.env прямо в deploy/,
# а там токены ботов, ключ шифрования кук и ключ Claude. Шаблоны *.env.example
# под правило не попадают — они кончаются на .example.
*.env
# Состояние и данные пользователей
notes.json
subscribers.json
users.json
sessions/
*.cookie
db.sqlite
db.sqlite-journal
output/
yesterday/
# Дампы грабера заметок (grab -out / -save-html): исследовательские выгрузки
# JSON и сырой HTML. Архив archive.db уже покрыт правилом data/ выше.
# ВНИМАНИЕ: testdata НЕ игнорируем — там реальные фикстуры под тесты.
# Исключение: сырой снимок мессенджера сайта с живыми секретами (Love.token,
# passport_id, hash push-канала) — не фикстура; санитизированные фикстуры
# talks появятся отдельно (см. briefs/love-talks-telegram.md §5).
/go/internal/love/testdata/love.ngs.ru.mhtml
dump/
.vscode/
.claude/
# Legacy-код, хранится только локально (main.py содержит токен)
main.py
poster_db.py
session_get.py
messages.py
# PEM сертификатов Минцифры для MAX: кладутся из Госуслуг перед сборкой,
# подлинность каждый проверяет сам (см. go/internal/maxx/cacert/README.md)
go/internal/maxx/cacert/*.pem
# Сервисные аккаунты сайта (куки технических сессий) и ключ их шифрования.
# Правило data/ покрывает только боевой каталог — на рабочей машине эти файлы
# лежат где угодно, поэтому имена перечислены явно.
accounts.db
accounts.db-journal
accounts.db-wal
accounts.db-shm
*.key
