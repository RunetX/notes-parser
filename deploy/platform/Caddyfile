# Реверс-прокси площадки. Caddy сам берёт и продлевает сертификат Let's Encrypt
# (проверено: ACME-директория с этого хоста отвечает 200).
#
# Почему Caddy, а не nginx+certbot: при одном администраторе связка из трёх мест
# (конфиг, крон продления, шаблон) — это три места, где что-то сгниёт молча.
# И не autocert внутри Go: сертификатам нужна запись, а контейнер приложения
# работает read_only, плюс статику пришлось бы отдавать через Go.

# Глобальные потолки соединения. Стоят они у прокси, а не в приложении, потому
# что приложение до медленного клиента просто не доходит: пока тело ползёт, Go
# держит горутину и слот. Здесь же обрывается и тот, кто открыл сокет молча.
{
	servers {
		timeouts {
			# read_body задаётся СЛУШАТЕЛЮ, матчером его не сузить, — поэтому
			# полторы минуты стоят у всех. Терпимо ровно потому, что тело у
			# всех остальных путей ограничено мегабайтом (см. request_body
			# ниже): медленно ползущий мегабайт занимает горутину, но не
			# память. Десять секунд, стоявшие здесь до 26.08.2026, обрывали
			# честную закачку картинки с телефона по мобильной сети.
			read_body 90s
			read_header 5s
			# ПОТОЛКА НА ЗАПИСЬ ЗДЕСЬ НЕТ, и это не упущение. Он задаётся
			# слушателю целиком, а не маршруту, — то есть обрывал бы и живой
			# канал (/live, SSE), поток которого живёт минутами по устройству.
			# Отдельный слушатель под него не годится: другой порт это другой
			# origin, а CSP площадки разрешает соединения только к своему.
			#
			# Прикрыт этот бок не здесь, а в приложении: у него свой
			# WriteTimeout в 45 с на ВСЕ обычные маршруты, и снимается он
			# ровно для одного соединения — того самого потока
			# (internal/web/live.go). То есть защита осталась там, где она
			# умеет различать маршруты.
			write 0
			idle 2m
		}
		max_header_size 16KB
	}
}

t3h.ru {
	encode zstd gzip

	# Медиа адресуются по sha256, поэтому содержимое по ссылке неизменно —
	# отсюда immutable на год. Файлы отдаёт Caddy, минуя приложение: это самый
	# жирный по трафику путь, а ядро на хосте одно.
	handle_path /media/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
		# Тип берётся из расширения файла (его задаёт хранилище по содержимому,
		# а не по ссылке), и угадывать браузеру нечего: загруженный когда-нибудь
		# «аватар», оказавшийся html, не должен исполниться на нашем домене.
		header X-Content-Type-Options nosniff
	}

	# Живой канал (SSE). Своим блоком ради flush_interval: без него поток
	# копится в буфере прокси и приезжает пачкой — соединение висит, а «живой»
	# страница не становится. Caddy распознаёт text/event-stream и сам, но
	# полагаться на догадку в том единственном месте, где от неё зависит смысл
	# всей затеи, незачем.
	handle /live {
		reverse_proxy platform:8080 {
			header_up X-Forwarded-For {http.request.remote.host}
			flush_interval -1
		}
	}

	# Тело запроса. Формы площадки текстовые, и потолок им прежний; исключение
	# ровно одно — публикация заметки, к которой участник вправе приложить одну
	# картинку (10 МБ плюс запас на текст и границы multipart).
	#
	# Матчеры ВЗАИМОИСКЛЮЧАЮЩИЕ намеренно: request_body — это обёртка тела, и
	# два сработавших подряд дали бы не больший из потолков, а последний.
	# Приложение режет тело и у себя (guard.maxBodyOf), здесь — чтобы лишнее не
	# доехало до Go вовсе.
	@shot {
		method POST
		path /new
	}
	@notshot {
		not {
			method POST
			path /new
		}
	}
	request_body @shot {
		max_size 11MB
	}
	request_body @notshot {
		max_size 1MB
	}

	reverse_proxy platform:8080 {
		# X-Forwarded-For ПЕРЕТИРАЕМ, а не дописываем. По умолчанию Caddy
		# добавляет адрес клиента к тому, что клиент прислал сам, — и первая
		# запись в заголовке становится строкой, которую он же и сочинил.
		# Потолки частоты считаются по адресу, поэтому подставной «127.0.0.1»
		# в начале заголовка стоил бы ровно столько же, сколько их отсутствие.
		header_up X-Forwarded-For {http.request.remote.host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Сырых IP не храним нигде, включая логи: они персональные данные, а утечка
	# — это 24 часа на уведомление РКН. Приложение хранит только HMAC, и лог
	# прокси не должен быть дырой в этом правиле.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
}

# Голый IP и любое другое имя — молча закрываем: сертификата на них нет, а
# отвечать содержимым на неизвестный Host незачем.
:80 {
	respond 404
}
