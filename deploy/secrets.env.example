# Секреты контейнера lovegw. Скопируйте в secrets.env (chmod 600),
# подставьте значения и раскомментируйте env_file в docker-compose.yml.
# Переменные перебивают одноимённые поля config.json.
LOVEGW_MIRROR_TOKEN=<токен постер-бота @ngslovebot>
LOVEGW_DM_TOKEN=<токен ЛС-бота команд @ryumkinbot>
LOVEGW_MAX_TOKEN=<токен MAX-бота: канал, чат обсуждения и ЛС-команды>
# Боты личной переписки сайта (talks) — опциональны; пусто, и переписку ведёт
# бот команд (telegram) / бот зеркала (max), как было раньше.
# LOVEGW_TG_TALKS_TOKEN=<токен telegram-бота переписки>
# LOVEGW_MAX_TALKS_TOKEN=<токен MAX-бота переписки; сюда же переезжает старый LOVEGW_MAX_DM_TOKEN>
LOVEGW_TG_PROXY=socks5://tgproxy:<пароль_прокси>@45.151.183.247:39080
# Ключ шифрования сессионных кук на диске (base64 32 байт; новый —
# `lovegw secrets keygen`). Пусто — куки лежат открыто, как раньше.
# ВАЖНО: после `lovegw secrets encrypt` ключ обязателен — без него демон не
# стартует, а сессии не прочитать. Храните его ОТДЕЛЬНО от бэкапов базы: смысл
# шифрования в том, что в копии БД ключа нет. Потеря = всем заново /login.
# LOVEGW_SECRET_KEY=<base64 32 байт>
# Ключ Claude API для LLM-рубрик дайджеста (значение — из pepper/.env,
# ANTHROPIC_API_KEY). Запросы идут через LOVEGW_TG_PROXY. Пусто — LLM выключен.
# LOVEGW_LLM_KEY=<ключ Anthropic API>
# Автораспознавание голосовых в тредах (Nexara). Провайдер российский — идёт
# напрямую, мимо прокси. Пусто — распознавание не включится.
# LOVEGW_ASR_ENABLED=true
# LOVEGW_ASR_API_KEY=<ключ Nexara, nx-…>
# Амвон: своя реплика под каждой новой заметкой (ключ Claude — общий,
# LOVEGW_LLM_KEY). Тумблер «работает сейчас» живёт в БД и переключается
# командой /pulpit; здесь — гейт самой службы.
# LOVEGW_PULPIT_ENABLED=true
# LOVEGW_PULPIT_MODEL=claude-opus-5
# LOVEGW_PULPIT_REPLY_PROBABILITY=0.05
# LOVEGW_DB_PATH переопределять не нужно — в образе уже /data/lovegw.db
# LOVEGW_ASR_FFMPEG переопределять не нужно — в образе уже /usr/local/bin/ffmpeg
