{
  "site": {
    "base_url": "https://love.ngs.ru",
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36",
    "request_interval_ms": 2000
  },
  "messengers": {
    "max": {
      "enabled": true,
      "token": "<токен MAX-бота или env LOVEGW_MAX_TOKEN>",
      "dm_token": "<токен ЛС-бота MAX или env LOVEGW_MAX_DM_TOKEN; пусто — ЛС через основного бота>",
      "channel_id": 0,
      "discussion_chat_id": 0,
      "admin_user_id": 0,
      "signature": "<подпись постов в MAX; пусто — общий signature>"
    },
    "telegram": {
      "enabled": false,
      "token": "<токен постер-бота или env LOVEGW_MIRROR_TOKEN>",
      "channel_id": -1001234567890,
      "discussion_chat_id": -1009876543210,
      "dm_token": "<токен ЛС-бота или env LOVEGW_DM_TOKEN>"
    }
  },
  "talks": {
    "enabled": false,
    "admin_only": true,
    "allow_send": false,
    "poll_interval_s": 30,
    "idle_poll_interval_s": 300,
    "max_dialogs_per_tick": 5,
    "max_requests_per_min": 6,
    "store_text": false,
    "retention_days": 30
  },
  "notes_limit": 5,
  "signature": "@your_channel",
  "admin_tg_user_id": 0,
  "feed_interval_s": 60,
  "db_path": "data/lovegw.db",
  "log_level": "info",
  "telegram_proxy": ""
}
