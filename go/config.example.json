      "discussion_chat_id": 0,
      "admin_user_id": 0,
      "signature": "<подпись постов в MAX; пусто — общий signature>"
    },
    "telegram": {
      "enabled": false,
      "token": "<токен постер-бота или env LOVEGW_MIRROR_TOKEN>",
      "channel_id": -1001234567890,
      "discussion_chat_id": -1009876543210,
      "dm_token": "<токен ЛС-бота команд (РюмкинЪ) или env LOVEGW_DM_TOKEN>",
