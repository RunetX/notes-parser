{{/* Каркас страницы. Один на всех: отдельной мобильной вёрстки у нас нет —
     в отличие от НГС, где живут две несовместимые (lv- и lvmb-), и правка в
     одной регулярно не доезжает до другой. */}}
<!doctype html>
<html lang="ru"{{if .Theme}} data-theme="{{.Theme}}"{{end}}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{/* Индексация запрещена и заголовком X-Robots-Tag, и здесь: читать площадку
     может каждый, но чужие тексты не должны оседать в поисковой выдаче. */}}
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="color-scheme" content="light dark">
<title>{{.Title}}</title>
<link rel="icon" href="{{asset "icon.svg"}}">
<link rel="stylesheet" href="{{asset "style.css"}}">
<script src="{{asset "app.js"}}" defer></script>
</head>
<body>
<header class="top">
  <div class="wrap topin">
    <a class="brand" href="/">{{site}}</a>
    <a class="tab" href="/">Общая лента</a>
    {{/* Правый верхний угол — там же, где вход на НГС (там он подписан «Вход
         на сайт» и живёт в lv-top-menu__user-menu). Читать можно и не входя:
         кнопка приглашает, а не преграждает. */}}
    {{if .SignedIn}}
    {{/* Меню участника — как на НГС: значок человека в правом верхнем углу, под
         ним выпадающий список. Там пунктов три («Мой профиль», «Настройки»,
         «Выход»), у нас два: отдельной страницы настроек площадка не заводит —
         ник и согласия живут на той же /me, и заводить пункт, ведущий туда же,
         значит обещать несуществующее.

         details/summary, а не скрипт: открываться меню обязано без JS, как и
         всё остальное здесь (строгий CSP запрещает inline-скрипты, а внешних
         зависимостей у площадки нет). Скрипт только закрывает его по клику
         мимо — это удобство, а не условие работы. */}}
    <details class="acct">
      <summary class="acctbtn" aria-label="Меню участника">
        <svg class="ico" viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <circle cx="10" cy="6.4" r="3.6"/>
          <path d="M10 11.4c-3.9 0-7 2.3-7 5.2v1.4h14v-1.4c0-2.9-3.1-5.2-7-5.2z"/>
        </svg>
        <span class="who">{{.Nick}}</span>
      </summary>
      <div class="acctmenu">
        <a href="/me">Мой профиль</a>
        <form method="post" action="/logout">
          <input type="hidden" name="back" value="{{.Back}}">
          <button type="submit">Выход</button>
        </form>
      </div>
    </details>
    {{else}}
    <div class="acct">
      <a class="enter" href="/login">Вход</a>
    </div>
    {{end}}
  </div>
</header>

<main class="main">
<div class="wrap">
{{template "content" .}}
</div>
</main>

<footer class="foot">
  <div class="wrap">
    <form class="themes" method="post" action="/theme">
      <span class="lbl">Оформление</span>
      <input type="hidden" name="back" value="{{.Back}}">
      {{$cur := .Theme}}{{range themes}}<button type="submit" name="theme" value="{{.ID}}" class="tbtn{{if eq .ID $cur}} on{{end}}"{{if eq .ID $cur}} aria-current="true"{{end}}>{{.Name}}</button>{{end}}
    </form>
    <p class="fine">Зеркало раздела «Заметки» love.ngs.ru. Страница закрыта от поисковиков.</p>
  </div>
</footer>
</body>
</html>
