{{/* Каркас страницы. Один на всех: отдельной мобильной вёрстки у нас нет —
     в отличие от НГС, где живут две несовместимые (lv- и lvmb-), и правка в
     одной регулярно не доезжает до другой. */}}
<!doctype html>
{{/* Атрибут стоит ВСЕГДА: не выбиравший получает тему по умолчанию
     (web.defaultTheme), и состояния «темы нет» у страницы не бывает. Условие
     здесь стояло, пока умолчание держал prefers-color-scheme. */}}
<html lang="ru" data-theme="{{.Theme}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{/* Запрета индексации здесь больше НЕТ (23.08.2026): страницы открыты
     поисковикам, а прежние редакции согласий, обещавшие обратное, заменены —
     distribution.v2 и processing.v3. Личное и служебное закрыто по-прежнему, но
     заголовком X-Robots-Tag на своих адресах (web.privatePath), а не общим
     мета-тегом: место запрета — там же, где список закрытого. */}}
<meta name="color-scheme" content="light dark">
<title>{{.Title}}</title>
{{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">{{end}}
<link rel="icon" href="{{asset "icon.svg"}}">
<link rel="stylesheet" href="{{asset "style.css"}}">
<script src="{{asset "app.js"}}" defer></script>
</head>
<body>
<header class="top">
  <div class="wrap topin">
    {{/* Название площадки — ЗНАКОМ и словом. Знак нужен телефону: на 360
         CSS-пикселях слово «Зазеркалье» занимает четверть строки шапки, и
         пятый её элемент уезжал второй строкой (жалоба владельца 23.08.2026)
         — то есть липкая шапка съедала пол-экрана треда. Знак это зеркало:
         рамка с бликом.

         Имя площадки при этом стоит на самой ссылке: title показывает его на
         наведении, aria-label читает вслух. Иначе на телефоне площадка
         осталась бы безымянной вовсе — слово рядом скрыто ПОКАЗОМ, а
         скрытого читалка не видит. */}}
    <a class="brand" href="/" title="{{site}}" aria-label="{{site}}">
      <svg class="mark" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
        <path fill="currentColor" fill-rule="evenodd" d="M10 1.4a6.1 6.1 0 0 0-6.1 6.1v5a6.1 6.1 0 0 0 12.2 0v-5A6.1 6.1 0 0 0 10 1.4zm0 1.8a4.3 4.3 0 0 1 4.3 4.3v5a4.3 4.3 0 0 1-8.6 0v-5A4.3 4.3 0 0 1 10 3.2z"/>
        <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M7.7 7.5 11.3 11.1"/>
      </svg>
      <span class="bname">{{site}}</span>
    </a>
    {{/* Разделы — ОДНИМ блоком с перегородкой, а не двумя плашками рядом:
         «Лента» и «Справка» это один переключатель, и порознь они читались как
         две несвязанные кнопки (жалоба владельца 23.08.2026). Справка вторым
         пунктом: правила и «как тут всё устроено» нужны переехавшему в первый
         же заход, а искать их в подвале он не догадается. Открыта всем,
         включая не вошедших. */}}
    <nav class="grp tabs">
      <a class="tab" href="/">Лента</a>
      <a class="tab" href="/help">Справка</a>
    </nav>
    {{/* Счётчик реплик той заметки, которую человек читает. Стоит он в ШАПКЕ, и
         это следствие того, что шапка стала липкой: из середины треда до
         заголовка «Комментарии N» уже не домотать, а число — первое, за чем туда
         возвращаются. Значком, а не словом: место в строке кончается раньше
         всего на телефоне, а по правилу Ш5з собственная метка обязана
         объясняться — отсюда title. Ссылка ведёт к началу треда.

         Стоит он и при НУЛЕ — по тому же правилу, что колокольчик ниже, но
         дорога сюда была другая: подкрутить число живой добор умеет, а создать
         счётчик нет, и в заметке, открытой пустой, он не появлялся до
         перезагрузки. Поэтому условие про СТРАНИЦУ, а не про число. */}}
    {{if .InThread}}
    <a class="hcount" href="#comments" title="Комментариев в этой заметке">
      {{template "ico-comment" 18}}
      <span class="n">{{.Thread}}</span>
    </a>
    {{end}}
    {{/* Правый верхний угол — там же, где вход на НГС (там он подписан «Вход
         на сайт» и живёт в lv-top-menu__user-menu). Читать можно и не входя:
         кнопка приглашает, а не преграждает. */}}
    {{if .SignedIn}}
    {{/* Правый угол участника — второй такой блок: колокольчик и меню это одно
         место «про меня», а не две кнопки подряд. */}}
    <div class="grp uctl">
    {{end}}
    {{if .Bell}}
    {{/* Колокольчик. Единственный элемент шапки, которого на НГС не было вовсе,
         — переносить нечего, значит действует правило про собственные метки
         (Ш5з): она обязана объясняться. Отсюда title и раздел в /help.

         Значок стоит и пустым: элемент, пропадающий при нуле, дёргает вёрстку
         на каждом переходе. Число — отдельным кружком, и «99+» решает Go
         (page.Capped), потому что это про потолок запроса, а не про вёрстку. */}}
    <a class="bell{{if .Unread}} has{{end}}" href="/events"
       title="События: ответы вам, упоминания и решения модерации">
      {{template "ico-bell"}}
      {{if .Unread}}<span class="cnt">{{if .Capped}}99+{{else}}{{.Unread}}{{end}}</span>{{end}}
    </a>
    {{end}}
    {{if .SignedIn}}
    {{/* Меню участника — как на НГС: значок человека в правом верхнем углу, под
         ним выпадающий список.

         Пункт про себя ОДИН, и это решение владельца 12.09.2026: «к чему
         отдельно „Мой профиль" и „Моя страница"». Утром того дня их было два —
         своя страница показывала список тумблеров, чужая карточку, — и человек
         оказывался перед выбором между двумя словами про одно и то же. Теперь
         /me это и есть профиль, тот же, что видят другие, а тумблеры уехали на
         его вкладку «Настройки».

         Зовётся пункт «Моей страницей» ПО БУМАГАМ, а не по вкусу: так её зовут
         все пять опубликованных согласий («отозвать можно на „Моей
         странице"»), а они неизменяемы — переименуй мы её, и документы стали
         бы указывать на несуществующее.

         details/summary, а не скрипт: открываться меню обязано без JS, как и
         всё остальное здесь (строгий CSP запрещает inline-скрипты, а внешних
         зависимостей у площадки нет). Скрипт только закрывает его по клику
         мимо — это удобство, а не условие работы. */}}
    <details class="acct">
      <summary class="acctbtn" aria-label="Меню участника">
        <svg class="ico" viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
          <circle cx="10" cy="6.4" r="3.6"/>
          <path d="M10 11.4c-3.9 0-7 2.3-7 5.2v1.4h14v-1.4c0-2.9-3.1-5.2-7-5.2z"/>
        </svg>
        <span class="who">{{.Nick}}</span>
      </summary>
      <div class="acctmenu">
        <a href="/me">Моя страница</a>
        {{/* Письма — ПУНКТОМ МЕНЮ, а не пятым значком в шапке: пятый элемент
             уже не помещался в строку на телефоне 23.08.2026 (довод выше, у
             названия площадки), а о новом письме говорит колокольчик — повод
             «вам написали» идёт шиной наравне с остальными. Число рядом с
             пунктом рисуется, только когда оно есть: пустой кружок ничего не
             сообщает, а место занимает. Пункта нет вовсе, пока переписка
             выключена, — MailOn, а не «MailUnread > 0», иначе он появлялся бы и
             пропадал на каждом переходе. */}}
        {{if .MailOn}}<a href="/mail">Письма{{if .MailUnread}} <span class="mn">{{.MailUnread}}</span>{{end}}</a>{{end}}
        {{/* Вход в очередь — здесь же: её смотрят между делом, из любого места,
             и помнить адрес наизусть модератор не должен. У остальных пункта
             нет вовсе — существование закрытой двери само по себе сведения. */}}
        {{if .Moderator}}<a href="/mod">Модерация</a>{{end}}
        {{/* Администрирование — соседняя дверь, и видна она только тому, кому
             открыта: модератор решает про слова, администратор про то, кто их
             здесь пишет (приглашения, права). Пункт отдельный, а не раздел
             внутри очереди, ровно поэтому. */}}
        {{if .Admin}}<a href="/mod/admin">Администрирование</a>{{end}}
        {{/* Оформление переехало сюда из подвала (решение владельца
             23.08.2026): тема — настройка «про меня», и место ей там же, где
             остальное про меня, а не в конце страницы рядом с документами.

             Плата с 30.08.2026 подорожала и названа честно: у гостя
             переключателя нет вовсе, а тему по умолчанию держит теперь не его
             система, а мы (web.defaultTheme) — значит гость видит «Витраж» и
             сменить его может только войдя. Форма с POST, а не ссылки: смена
             темы меняет состояние, а GET-ссылку браузер нажимает сам в
             префетче. */}}
        <form class="themes" method="post" action="/theme">
          <span class="lbl">Оформление</span>
          <input type="hidden" name="back" value="{{.Back}}">
          {{$cur := .Theme}}{{range themes}}<button type="submit" name="theme" value="{{.ID}}" class="tbtn t-{{.ID}}{{if eq .ID $cur}} on{{end}}"{{if eq .ID $cur}} aria-current="true"{{end}}>{{.Name}}</button>{{end}}
        </form>
        <form method="post" action="/logout">
          <input type="hidden" name="back" value="{{.Back}}">
          <button type="submit">Выход</button>
        </form>
      </div>
    </details>
    </div>
    {{else}}
    {{/* Гостю в углу одна кнопка — блока из одной кнопки не бывает. */}}
    <div class="acct">
      <a class="enter" href="/login">Вход</a>
    </div>
    {{end}}
  </div>
</header>

{{/* Мордолента стои́т НАД карточкой, а не внутри неё, и это перенос вида с НГС:
     там section.lv-top-tape — сосед блока содержимого, а не его часть (просьба
     владельца 30.08.2026). Отсюда и поле в ОБЩЕЙ части страницы, а не в данных
     ленты: рисует полосу каркас, и лезть из него в поля одной страницы значило
     бы уронить все остальные — тот же довод, что у счётчика реплик в шапке.
     Заполняет поле только лента и только на первой странице. */}}
{{if .Faces}}{{template "faces" .Faces}}{{end}}

<main class="main">
<div class="wrap">
{{template "content" .}}
</div>
</main>

<footer class="foot">
  <div class="wrap">
    {{/* Подвал держит ДОКУМЕНТЫ, и только их. Справка отсюда убрана: она
         вкладкой в шапке, то есть видна с любой страницы и сверху, а дубль внизу
         занимал место, которое нужнее бумагам. Бумаги же ищут именно здесь — по
         привычке всего остального интернета, и ссылка на них обязана стоять на
         КАЖДОЙ странице: политику, которую видно только из профиля, читать
         пойдёт разве что тот, кто уже вошёл. */}}
    <nav class="fnav">
      <a href="/consents">Соглашения</a>
      <a href="/privacy">Политика конфиденциальности</a>
      <a href="/disclaimer">Отказ от ответственности</a>
    </nav>
  </div>
</footer>
</body>
</html>
