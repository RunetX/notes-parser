{{/* Полоска действий под публикацией.

     Стоит она ТАМ, ГДЕ ЧИТАЮТ, а не только в очереди, и это главное решение по
     виду модерации: скрывать реплику, не видя разговора вокруг, — значит судить
     по цитате, а именно разговор вокруг и отличает ссору от угрозы. С
     26.08.2026 «там, где читают» включает и ЛЕНТУ: до этого дня за каждым
     решением приходилось открывать страницу заметки, а скрытая заметка
     пропадала у модератора вместе со всеми — вернуть её можно было только из
     очереди.

     Под заметкой полоска шире, чем под репликой: у заметки есть замок треда,
     закрепление и правка администратора. Ветка одна и решает поле IsNote —
     двумя копиями шаблона это разъехалось бы на первой же кнопке.

     Формы, а не ссылки: действие меняет состояние, и делать его переходом по
     адресу нельзя — такую ссылку однажды откроет предзагрузчик браузера.
     Скрытый csrf стоит в каждой: то же правило, что у всех пишущих форм.

     Аргумент — modAct (см. render.go): пара «объект + куда вернуться». */}}
{{define "modbar"}}
{{- $m := . -}}
{{- if or $m.CanModerate $m.CanReport -}}
<p class="modbar">
  {{if $m.CanModerate}}
    {{if $m.Hidden}}
    <span class="mtag">скрыто модерацией</span>
    <form method="post" action="/mod/act" class="minline">
      <input type="hidden" name="csrf" value="{{$m.CSRF}}">
      <input type="hidden" name="back" value="{{$m.Back}}">
      <input type="hidden" name="kind" value="{{$m.Subject.Kind}}">
      <input type="hidden" name="id" value="{{$m.Subject.ID}}">
      <input type="hidden" name="do" value="restore">
      <button type="submit" class="mbtn">Вернуть</button>
    </form>
    {{else}}
    <form method="post" action="/mod/act" class="minline">
      <input type="hidden" name="csrf" value="{{$m.CSRF}}">
      <input type="hidden" name="back" value="{{$m.Back}}">
      <input type="hidden" name="kind" value="{{$m.Subject.Kind}}">
      <input type="hidden" name="id" value="{{$m.Subject.ID}}">
      <input type="hidden" name="do" value="hide">
      <button type="submit" class="mbtn">Скрыть</button>
    </form>
    {{end}}
    {{if $m.IsNote}}
    {{/* Замок треда — наш, а не перенос отметки НГС «не актуальна»: та стоит у
         62 % зеркальных заметок и появляется через минуты после публикации, то
         есть запирать ею разговор значило бы открыть площадку в режиме чтения
         ровно там, где он идёт. */}}
    <form method="post" action="/mod/act" class="minline">
      <input type="hidden" name="csrf" value="{{$m.CSRF}}">
      <input type="hidden" name="back" value="{{$m.Back}}">
      <input type="hidden" name="note" value="{{$m.NoteID}}">
      <button type="submit" name="do" value="{{if $m.Locked}}unlock{{else}}lock{{end}}" class="mbtn">
        {{if $m.Locked}}Открыть обсуждение{{else}}Закрыть обсуждение{{end}}</button>
    </form>
    {{/* Закрепление — соседняя кнопка, потому что решение того же рода: оба
         меняют не текст, а место заметки в общем разговоре. В ЛЕНТЕ она к тому
         же стоит там, где решение и принимается: место в ленте видно только из
         ленты. */}}
    <form method="post" action="/mod/act" class="minline">
      <input type="hidden" name="csrf" value="{{$m.CSRF}}">
      <input type="hidden" name="back" value="{{$m.Back}}">
      <input type="hidden" name="note" value="{{$m.NoteID}}">
      <button type="submit" name="do" value="{{if $m.Pinned}}unpin{{else}}pin{{end}}" class="mbtn">
        {{if $m.Pinned}}Открепить{{else}}Закрепить наверху{{end}}</button>
    </form>
    {{end}}
    {{if $m.AdminEdit}}<a class="mlink" href="/n/{{$m.NoteID}}/edit"
       title="Правка администратора: текст заметки, без автора и анонимности">Поправить</a>{{end}}
    {{if $m.AuthorID}}<a class="mlink" href="/mod/u/{{$m.AuthorID}}">Автор</a>{{end}}
  {{else if $m.CanReport}}
    {{/* Ссылка, а не форма: жалоба — это текст, и поле ввода под каждой из
         девятисот реплик было бы ровно тем, чего мы избежали у реакций. */}}
    <a class="mlink" href="/report?kind={{$m.Subject.Kind}}&amp;id={{$m.Subject.ID}}&amp;note={{$m.NoteID}}">Пожаловаться</a>
  {{end}}
</p>
{{- end -}}
{{end}}
