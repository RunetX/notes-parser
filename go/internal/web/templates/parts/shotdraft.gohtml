{{/* Карточка приложенной картинки: то, что человек увидит вместо ожидания.

     Рисуется ДВАЖДЫ и одним шаблоном — ответом на предзагрузку (POST /shot) и
     самой формой, когда та перерисовывается после отказа. Иначе картинка
     показывалась бы двумя способами, и однажды они разошлись бы.

     Показывается УЖЕ ПЕРЕКОДИРОВАННОЕ (адрес /shot/<id> отдаёт ровно те байты,
     что лягут в заметку), а не выбранный файл: у него другой размер, другой
     поворот и данные съёмки внутри. Обещать одно, а положить другое — то же
     враньё, что и молча опубликовать заметку без картинки.

     Скрытое поле здесь, а не в скрипте: разметку площадки собирает СЕРВЕР.

     «Убрать» — единственная кнопка площадки, которая без JS ничего не делала бы;
     правило не нарушено, потому что и самой карточки без JS не бывает: черновик
     заводит только предзагрузка, а она вся в скрипте. */}}
{{define "shotdraft"}}
{{if .Problem}}
<p class="bad">{{.Problem}}</p>
{{else if .ID}}
<input type="hidden" name="shot_id" value="{{.ID}}">
{{/* Размеры атрибутами — чтобы страница не прыгала, пока картинка рисуется:
     показ ужимает её CSS, а место под неё браузер знает заранее. */}}
<img class="shotprev" src="/shot/{{.ID}}" width="{{.Width}}" height="{{.Height}}"
  alt="Приложенная картинка">
<p class="fine">Картинка готова — {{.Width}} × {{.Height}} точек, уйдёт вместе с заметкой.
  <button type="button" class="shotdrop">Убрать</button></p>
{{end}}
{{end}}
