{{/* Аватар. Пустая ссылка — рабочий случай, а не поломка: байты картинки
     приезжают только живым потоком зеркала, у исторических строк их может не
     быть вовсе. Тогда рисуем букву — она всегда есть.

     Адрес тут всегда наш, /media/…: ссылки на hsmedia.ru наружу не уходят,
     иначе смерть НГС забрала бы с собой и наши страницы, а до тех пор
     сообщала бы ему каждого нашего читателя. */}}
{{define "avatar"}}
{{- if .URL -}}
<img class="ava" src="{{.URL}}" alt="" width="100" height="100" loading="lazy" decoding="async">
{{- else -}}
<span class="ava none" aria-hidden="true">{{.Initial}}</span>
{{- end -}}
{{end}}
