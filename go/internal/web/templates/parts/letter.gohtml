{{/* Одно письмо. Частью, а не разметкой внутри страницы, по тому же доводу, что
     «comment» и «note_item»: рисовать письмо будут ДВОЕ — страница переписки и
     живой добор (Ш5), — и второго способа превратить текст в HTML у площадки не
     заводится. Заведись он, однажды в одном из двух забудут про смайлы, про
     разметку или про стёртое по сроку содержание.

     СВОЁ письмо и ЧУЖОЕ различаются классом, а не колонкой и не выравниванием:
     это переписка двоих, а не чат с пузырями, и площадка держит один вид на все
     свои страницы. Имени над письмом нет вовсе — собеседник ровно один, и он
     назван в шапке страницы. */}}
{{define "letter"}}
{{$l := .Letter}}
<li class="lt{{if $l.FromMe}} mine{{end}}" id="l{{$l.ID}}">
  <div class="lth">
    {{/* Подписано только СВОЁ письмо. Имени собеседника здесь нет намеренно: он
         ровно один и назван в шапке страницы, а подпись над каждой строкой
         повторяла бы его полсотни раз подряд. */}}
    {{if $l.FromMe}}<span class="ltwho">Вы</span>{{end}}
    {{when $l.SentAt true}}
    {{/* «Пожаловаться» — единственная дверь, через которую чужое письмо
         становится видно третьему человеку, и открывает её получатель. Ведёт на
         отдельную страницу, а не раскрывает поле под письмом: жалоба это текст,
         и поле под каждым из полусотни писем было бы ровно тем, чего площадка
         избежала у реакций. */}}
    {{if .CanReport}}<a class="ltrep" href="/mail/report?m={{$l.ID}}">Пожаловаться</a>{{end}}
  </div>
  {{if $l.Purged}}
  {{/* Стёртое по сроку — НЕ пустота и не поломка: строка письма жива, а
       содержания больше нет. Молча исчезнувшее письмо читается как потеря, а
       это закон, и сказать о нём надо словами. */}}
  <p class="ltx gone">Содержание удалено по сроку хранения.</p>
  {{else}}
  <div class="ltx">{{letterBody $l}}</div>
  {{end}}
</li>
{{end}}
