{{/* Форма ответа. Одна на страницу — но встаёт она ПОД адресатом, а не внизу
     треда: на НГС «Ответить» уводило к общей форме внизу, и это ровно то, на
     что пожаловался владелец 23.08.2026 — нажал, уехал в конец страницы, потом
     листай обратно к месту разговора. Тот случай, когда перенос привычки
     проигрывает удобству: место разговора важнее места формы.

     Устройство прежнее и без JS работает так же: страница перезагружается с
     ?reply=<id>, форма получает адресата, набранное не теряется. Изменилось
     только МЕСТО вывода (pages/note.gohtml) и якорь ссылки — теперь она ведёт
     на саму реплику. */}}
{{define "reply"}}
{{- $n := .Note -}}
<section class="replybox" id="reply">
{{if .Note.Locked}}
  <p class="fine">Обсуждение закрыто модератором.</p>
{{else if and .Note.Stage (not .CanWrite)}}
  {{/* Песочница (эпик «народ»). Объяснение стоит ВЫШЕ проверки «вошёл ли»: гостю
       здесь «войдите, чтобы ответить» было бы неправдой — войдя, он всё равно не
       сможет. Имён жителей строка не называет, как и метка происхождения: про то,
       что на площадке живут персонажи, сказано в справке одним разделом. */}}
  <p class="fine">В этой заметке говорят её жители — ответить нельзя.
  <a href="/help#narod">Что это такое</a>.</p>
{{else if .CanWrite}}
  {{if .Compose.Problem}}<p class="bad">{{.Compose.Problem}}</p>{{end}}

  {{if .ReplyTo}}
  <p class="repto">Ответ: <a href="#c{{.ReplyTo.ID}}">{{.ReplyTo.Name}}</a>
    · <a class="alt" href="{{threadURL .ReplyBase}}">в общий тред</a></p>
  {{/* Единственное место, где «своё» и «пришедшее с НГС» различаются на экране,
       и различие показано на АВТОРЕ, а не на реплике. Вопрос у отвечающего не
       «откуда этот текст», а «дойдёт ли мой ответ», и честный ответ — вот он.
       Метка тает сама: человек войдёт, и тень станет участником. */}}
  {{if .ReplyTo.Author.Shadow}}
  <p class="fine">{{.ReplyTo.Name}} ещё не переехал сюда с НГС: ответ увидят здесь,
  на самом НГС он не появится.</p>
  {{end}}
  {{else}}
  <p class="repto">Ответ на заметку</p>
  {{end}}

  <form method="post" action="/n/{{$n.ID}}/reply" class="wform">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <input type="hidden" name="reply_to" value="{{.Compose.ReplyTo}}">
    <textarea name="body" rows="5" required placeholder="Ваш ответ">{{.Compose.Body}}</textarea>
    {{template "smilepick"}}
    {{template "markpick"}}
    {{/* Галочки «анонимно» тут нет и не будет: анонимной бывает заметка, а
         реплика подписана всегда — так на НГС, и разница не косметическая.
         Заметку анонимно ПУБЛИКУЮТ, а в тред анонимно ОТВЕЧАЮТ людям, которые
         ответить тем же не могут. */}}
    <div class="wact">
      <button type="submit">Ответить</button>
    </div>
  </form>
{{else if not .SignedIn}}
  <p class="fine">Читать можно всем. Чтобы ответить — <a href="/login">войдите</a>.</p>
{{end}}
</section>
{{end}}
