{{/* Значки полоски действий. Одним местом и одним шаблоном, а не восемью
     копиями по разметке: набор обязан быть согласован между собой, а
     несогласованность в нём видна не в diff'е, а только глазом на странице.

     Заведены они 26.08.2026 по просьбе владельца — на телефоне подписи у
     кнопок модератора не помещались в строку и складывались в кучку. Поэтому
     подпись НЕ УДАЛЕНА, а спрятана показом: на десктопе слова остаются, на
     телефоне остаётся значок. Тот же приём и та же причина, что у постранички
     (ширины экрана сервер не знает, значит разметка обязана НАЗВАТЬ, что
     прятать) — с одной добавкой: подпись прячется .sr-only, а не display:none,
     иначе у кнопки пропало бы имя и для читалки.

     Рисуются ОБВОДКОЙ, а не заливкой, — в отличие от значков шапки. Они стоят
     в одном ряду друг с другом, и смешанный ряд «залитый человек рядом с
     обведённым глазом» выглядит набором из двух разных мест. Значок реплики в
     строке ниже, наоборот, ЗАЛИТЫЙ: он повторяет тот, что стоит в липкой
     шапке, и человек уже видел его сегодня.

     viewBox 20×20 — как у шапки; currentColor — чтобы значок жил во всех
     четырёх палитрах и не заводил себе цвета. */}}
{{define "ico"}}
<svg class="ico" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
{{- if eq . "hide"}}
  {{/* Глаз перечёркнутый: «этого больше не видно». */}}
  <path d="M10 4.6c4 0 7.2 2.9 8.5 5.4-1.3 2.5-4.5 5.4-8.5 5.4S2.8 12.5 1.5 10C2.8 7.5 6 4.6 10 4.6z"/>
  <circle cx="10" cy="10" r="2.4"/>
  <path d="M4.2 4.2 15.8 15.8"/>
{{- else if eq . "show"}}
  {{/* Тот же глаз без черты: «вернуть на виду». */}}
  <path d="M10 4.6c4 0 7.2 2.9 8.5 5.4-1.3 2.5-4.5 5.4-8.5 5.4S2.8 12.5 1.5 10C2.8 7.5 6 4.6 10 4.6z"/>
  <circle cx="10" cy="10" r="2.4"/>
{{- else if eq . "lock"}}
  <rect x="4.2" y="9" width="11.6" height="8.2" rx="1.6"/>
  <path d="M7.2 9V6.9a2.8 2.8 0 0 1 5.6 0V9"/>
{{- else if eq . "unlock"}}
  {{/* Тот же замок с ОТКРЫТОЙ дужкой — она не возвращается вниз. */}}
  <rect x="4.2" y="9" width="11.6" height="8.2" rx="1.6"/>
  <path d="M7.2 9V6.9a2.8 2.8 0 0 1 5.6 0"/>
{{- else if eq . "top"}}
  {{/* Стрелка к черте сверху. Булавку не рисуем намеренно: закрепление здесь
       означает буквально «наверх ленты», и стрелка говорит это без словаря. */}}
  <path d="M4.5 3.2h11M10 16.8V6.4M6 10.4 10 6.4l4 4"/>
{{- else if eq . "untop"}}
  {{/* Та же стрелка вниз: заметка возвращается на своё место в ленте. */}}
  <path d="M4.5 3.2h11M10 6.4v10.4M6 12.8l4 4 4-4"/>
{{- else if eq . "edit"}}
  <path d="M14.1 3.4 16.6 5.9 7.2 15.3l-3.4.9.9-3.4z"/>
{{- else if eq . "user"}}
  <circle cx="10" cy="6.6" r="3.2"/>
  <path d="M3.9 17c0-3.2 2.7-5.2 6.1-5.2s6.1 2 6.1 5.2"/>
{{- end}}
</svg>
{{- end}}

{{/* Значок реплики — ТОТ ЖЕ, что в липкой шапке (base.gohtml). Ровно тот же,
     а не похожий: человек видит его наверху страницы всё время, пока читает
     тред, и второй знак о том же самом пришлось бы объяснять заново. */}}
{{define "ico-comment"}}
<svg class="ico" viewBox="0 0 20 20" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
  <path d="M3 4.6A1.6 1.6 0 0 1 4.6 3h10.8A1.6 1.6 0 0 1 17 4.6v7.2a1.6 1.6 0 0 1-1.6 1.6H8.2L4.4 17a.6.6 0 0 1-1-.45v-2.95A1.6 1.6 0 0 1 3 11.8z"/>
</svg>
{{- end}}

{{/* Метка происхождения (origin.go). Своё — ЗНАК САМОЙ ПЛОЩАДКИ, тот же, что
     стоит в шапке: другого знака у нас нет, а второй означал бы, что их два.
     Чужое — ДВА ЛИСТА, обычный знак копии. Стрелка наружу стояла здесь до
     27.08.2026, пока метка была ссылкой на оригинал; ссылок на НГС площадка
     больше не ставит, а стрелка наружу у некликаемого значка обещала бы переход,
     которого не будет. Имя чужого сайта на карточке не печатается вовсе
     (решение владельца 26.08.2026) — оно остаётся в заголовке и в спрятанной
     подписи для читалки, а не попадается на глаза двадцать раз на страницу. */}}
{{define "ico-origin"}}
{{- if eq . "stage"}}
{{/* Песочница — МИКРОСХЕМА: разговор в этой заметке ведёт машина, и знак должен
     говорить именно это. Театральной маски здесь быть не может — она означала бы
     игру, притворство живого; а площадка про своих жителей не притворяется. */}}
<svg class="ico" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  <rect x="5.6" y="5.6" width="8.8" height="8.8" rx="1.6"/>
  <path d="M8.4 2.6v3M11.6 2.6v3M8.4 14.4v3M11.6 14.4v3M2.6 8.4h3M2.6 11.6h3M14.4 8.4h3M14.4 11.6h3"/>
</svg>
{{- else if eq . "own"}}
<svg class="ico" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false">
  <path fill="currentColor" fill-rule="evenodd" d="M10 1.4a6.1 6.1 0 0 0-6.1 6.1v5a6.1 6.1 0 0 0 12.2 0v-5A6.1 6.1 0 0 0 10 1.4zm0 1.8a4.3 4.3 0 0 1 4.3 4.3v5a4.3 4.3 0 0 1-8.6 0v-5A4.3 4.3 0 0 1 10 3.2z"/>
  <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" d="M7.7 7.5 11.3 11.1"/>
</svg>
{{- else}}
<svg class="ico" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false"
     fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  <path d="M7.4 2.9h6a1.6 1.6 0 0 1 1.6 1.6v7.6"/>
  <rect x="3.4" y="6.1" width="9.2" height="11" rx="1.6"/>
</svg>
{{- end}}
{{- end}}
