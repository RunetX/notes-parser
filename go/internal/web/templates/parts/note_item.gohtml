{{/* Одна заметка ленты. Вынесена по той же причине, что и «comment»: рисуют её
     двое — сама лента и живой добор, — а путь сборки текста обязан остаться
     один. Точка та же пара, её собирает глагол `ni`. */}}
{{define "note_item"}}
{{- $n := .Note}}
<li class="note{{if $n.Pinned}} pinned{{end}}{{if ne $n.Status 0}} nhid{{end}}" id="n{{$n.ID}}">
  {{/* Автор — колонка слева: квадратный аватар, ник под ним. Ровно как на
       НГС; это первое, по чему постоянный читатель узнаёт страницу. */}}
  <div class="author">
    {{template "avatar" (av $n.Author.AvatarURL $n.Author.Gender $n.Anonymous)}}
    <span class="nick {{$n.Author.Gender.Class}}{{if $n.Anonymous}} anon{{end}}">{{$n.Name}}</span>
  </div>
  <div class="nbody">
    {{/* Метка закрепления — на самой заметке, а не над блоком: закреплённые
         стоят в общем списке, и без метки старая запись наверху читается как
         поломка сортировки. */}}
    {{if $n.Pinned}}<p class="pin">Закреплено</p>{{end}}
    {{/* Длинная заметка показывается НАЧАЛОМ (решение владельца 23.08.2026:
         «полный текст выглядит слишком громоздко»). На НГС лента показывала
         текст целиком, и это тот случай, когда мы от оригинала отходим
         сознательно: там заметки были короче, а у нас в ленту попадают и
         объявления площадки, и выпуск дайджеста — одна такая простыня съедает
         экран, за которым лежат ещё девятнадцать заметок.

         Механизм ТОТ ЖЕ, что у простыни в треде: галочка с подписью, а не
         скрипт (без JS страница обязана работать), и текст отдаётся ЦЕЛИКОМ —
         сворачивание это показ, а не обрезка, иначе поиск по странице терял бы
         половину заметки. Идентификатор с приставкой «n»: в ленте номера
         заметок, в треде — реплик, и пересекаться им незачем.

         На СВОЕЙ странице заметка не сворачивается никогда: туда пришли читать
         именно её. Там своя разметка (pages/note.gohtml), и это же причина,
         по которой кат живёт здесь, а не в общем шаблоне текста. */}}
    {{if long $n.Body}}
    <input class="expand" type="checkbox" id="exn{{$n.ID}}">
    <div class="text clip">{{body $n}}</div>
    <label class="more" for="exn{{$n.ID}}"><span class="mo">Показать полностью</span><span class="mc">Свернуть</span></label>
    {{else}}
    <div class="text">{{body $n}}</div>
    {{end}}
    {{/* Вне ката по той же причине, что и в треде: свёрнутый текст прячет
         слова, но не то, что к заметке приложен ролик. */}}
    {{template "videos" (vid $n.ID $n.Body)}}
    {{/* Иллюстрация прямо в карточке: заметка с картинкой без картинки читается
         как заметка о чём-то другом. Ведёт она на заметку, а не на файл — в
         ленте нажатие означает «открыть», а не «рассмотреть». Размер отдаём
         атрибутами, чтобы лента не прыгала, пока картинки грузятся. */}}
    {{with index .Page.Shots $n.ID}}{{if .URL}}
    <a class="thumb" href="/n/{{$n.ID}}"><img src="{{.URL}}" alt="Иллюстрация к заметке"
      {{- if .Width}} width="{{.Width}}" height="{{.Height}}"{{end}} loading="lazy" decoding="async"></a>
    {{end}}{{end}}
    <div class="nfoot">
      {{when $n.PublishedAt $n.PublishedExact}}
      {{/* Метка происхождения (origin.go, правило Ш5з). Стоит сразу за датой и
           НЕ между «Комментарии» и числом: там её ищет fidelity_test, сверяя
           надпись ленты с оригиналом. */}}
      {{with origin $n.ID $n.Stage}}<span class="orig" title="{{.Title}}">{{template "ico-origin" .Icon}}<span class="sr-only">{{.Label}}</span></span>{{end}}
      {{/* Закрытое обсуждение показывается ТОЙ ЖЕ надписью, что и отметка НГС
           «не актуальна»: для читателя оба состояния значат одно — заглянуть
           можно, вступить нельзя, — и заводить ради нашего замка вторую
           формулировку значило бы объяснять человеку разницу между чужой
           отметкой и нашим решением. Разница есть, но она про право писать, а
           не про то, что видно в ленте. */}}
      {{if or $n.CommentsClosed $n.Locked}}
      <a class="clink" href="/n/{{$n.ID}}">Заметка неактуальна, но вы можете ознакомиться с её обсуждением <span class="cnt">{{$n.CommentCount}}</span></a>
      {{else}}
      {{/* Значок реплики стоит ТОЛЬКО здесь, у обычного «Комментарии N», и на
           телефоне заменяет собой слово (решение владельца 26.08.2026). У
           неактуальной заметки строкой выше значка НЕТ и не будет: там не
           подпись к кнопке, а утверждение о самой заметке — «заглянуть можно,
           вступить нельзя», — и заменять утверждение значком значит стереть
           сказанное, а не сократить его. */}}
      <a class="clink" href="/n/{{$n.ID}}" title="Перейти к обсуждению"
        >{{template "ico-comment"}}<span class="lbl">Комментарии</span> <span class="cnt">{{$n.CommentCount}}</span></a>
      {{end}}
      {{/* «Добавить комментарий» — вход в разговор прямо из ленты, как на НГС
           у вошедшего. Гостю его там нет вовсе, и у нас нет: ссылка, ведущая
           к отказу, хуже её отсутствия.
           Под неактуальной заметкой её нет тоже — при ЛЮБОЙ причине, замок ли
           это модератора или чужая отметка НГС. Решение владельца 18.08.2026,
           и оно про строку выше: там уже сказано «ознакомиться с обсуждением»,
           то есть разговор окончен, — звать в него следующей же ссылкой
           значит спорить с самим собой. Право писать при этом прежнее: отметка
           НГС его не отнимает (Ш5), и форма на странице заметки работает. */}}
      {{if and .Page.CanWrite (not $n.Locked) (not $n.CommentsClosed) (not $n.Stage)}}
      <a class="addc" href="/n/{{$n.ID}}#reply">Добавить комментарий</a>
      {{end}}
    </div>
    {{/* Полоска модератора — та же самая, что под заметкой на её странице
         (parts/modbar.gohtml): скрыть и вернуть, закрепить, замок, автор, а у
         администратора ещё и правка. Здесь она нужнее, чем там: решения
         принимают, просматривая ленту, и до 26.08.2026 за каждым приходилось
         открывать заметку — а скрытую и открыть-то было неоткуда, из ленты она
         пропадала вместе со всеми.

         Читателя это не касается: «Пожаловаться» в ленте не показывается вовсе
         (см. modFeedNote), и у него полоска пустая — то есть её нет. */}}
    {{template "modbar" (modf .)}}
  </div>
</li>
{{end}}
