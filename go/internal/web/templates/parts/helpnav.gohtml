{{/* Оглавление справки внизу каждой темы: куда идти дальше.

     Внизу, а не сверху, намеренно. Человек приходит на страницу с вопросом, и
     первое, что он обязан увидеть, — ответ, а не одиннадцать плиток, за которые
     ответ уехал под нижний край телефона. Наверху остаётся одна ссылка назад,
     в оглавление.

     Открытая тема из списка выпадает: ссылка на страницу, где ты стоишь, —
     это кнопка, ничего не делающая при нажатии. */}}
{{define "helpnav"}}
<nav class="more">
  <h2>Другие разделы</h2>
  <div class="toc">
    {{range .Topics}}{{if ne .Slug $.Current}}<a href="/help/{{.Slug}}">{{.Title}}</a>{{end}}{{end}}
  </div>
</nav>
{{end}}

{{/* Ссылка наверх страницы темы. Отдельным шаблоном, потому что стои́т она на
     каждой из одиннадцати, а «Справка» в шапке ведёт туда же — но шапка
     липкая и мелкая, а здесь нужна строка, читаемая как «вы внутри раздела». */}}
{{define "helpback"}}
<p class="crumb"><a href="/help">Справка</a> → {{.}}</p>
{{end}}
