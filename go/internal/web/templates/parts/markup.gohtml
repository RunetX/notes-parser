{{/* Справочник разметки под формой — пара к выбиралке смайлов.

     Разметка та же, что была у НГС ([b], [i], [u], [s], [color=…]), и работает
     она в написанном ЗДЕСЬ (см. eraOf). Знать о ней человеку неоткуда: на самом
     сайте эти теги умерли в 2014-м, а у нас ожили обратно, — поэтому справочник
     и стоит прямо под полем ввода, а не в справке через две страницы.

     Кнопок здесь нет намеренно, в отличие от смайлов: смайл это КОД, который без
     подсказки не набрать, а «[b]…[/b]» ставится вокруг уже написанного — без JS
     такая кнопка ничего бы не делала, а мёртвых кнопок на странице не бывает.

     Образец в каждой строке прогнан тем же разбором, что и тело заметки
     (markupHelp): подсказка, разошедшаяся с поведением, хуже отсутствующей. */}}
{{define "markpick"}}
<details class="smbox">
  <summary>Разметка</summary>
  <ul class="mkref">
    {{range markuphelp}}<li><code>{{.Code}}</code> — {{.Sample}}</li>{{end}}
  </ul>
</details>
{{end}}
