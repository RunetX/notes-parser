{{/* Выбиралка смайлов под формой: весь набор НГС, 64 знака.

     Без JS это СПРАВОЧНИК: картинка и её код рядом, код можно набрать руками —
     ровно так люди и делали тринадцать лет. Со скриптом (app.js) панель
     становится кликабельной и вставляет код в текст на месте курсора. Кнопок
     сервер не рисует намеренно: кнопка, которая без JS ничего не делает, хуже
     её отсутствия — то же правило, что у «свернуть ветку».

     Панель закрыта по умолчанию (details): открывший форму пришёл писать, а не
     разглядывать шестьдесят четыре картинки. */}}
{{define "smilepick"}}
<details class="smbox">
  <summary>Смайлы</summary>
  <div class="smgrid">
    {{range smilelist}}<span class="smi" data-code="{{.}}">{{smile .}}<code>:::{{.}}:::</code></span>{{end}}
  </div>
</details>
{{end}}
