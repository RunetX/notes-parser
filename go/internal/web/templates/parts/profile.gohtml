{{/* Профиль человека: справочная колонка, альбом, рассказ и последние записи.

     ОДИН шаблон на две страницы — свою и чужую. До 12.09.2026 их было два, и
     показывали они разное про одного и того же человека: «Моя страница» —
     список тумблеров, /u/<id> — карточку с рассказом, — отчего искавший свой
     профиль попадал в настройки, а сделанную для него страницу не видел вовсе.
     Теперь показ общий, а различает страницы ровно одно поле — .Edit, правка,
     которой у чужой нет.

     Формы стоят ТАМ ЖЕ, где показ, и это главное правило этого файла: человек
     правит то, что видит. Развести их по разным адресам значит однажды
     показать одно, а править другое. */}}
{{define "profile"}}
{{$m := .Member}}{{$e := .Edit}}

{{if .AboutHidden}}
<p class="warn">Карточка скрыта модератором: рассказ, город, занятие и
фотографии видите только вы и модератор.
{{if $e}}Написать ему можно со страницы <a href="/report">жалоб и обращений</a>.{{end}}</p>
{{end}}

{{/* Две колонки. Обе половины сетки рисуются вместе или не рисуются вовсе
     (.HasSide считается в Go): .ucols без .uside положил бы записи в колонку
     шириной 220px, и страница схлопнулась бы в полосу. У хозяина колонка
     стои́т всегда — в ней живут формы. */}}
{{if .HasSide}}
<div class="ucols">
  <div class="uside">
    {{/* Каждый блок колонки — в своей обёртке: отступ между ними ставит
         правило соседства (.uside > * + *), а у самого ярлыка margin-top
         нулевой — иначе «АЛЬБОМ» прилипает к последней строке фактов. */}}
    {{if or .Facts $e}}
    <div>
      <h2 class="lbl">О себе</h2>
      {{if .Facts}}
      <dl class="ufacts">
        {{range .Facts}}<dt>{{.K}}</dt><dd>{{.V}}</dd>{{end}}
      </dl>
      {{else}}
      <p class="fine">Город и занятие не указаны.</p>
      {{end}}
    </div>
    {{end}}
    {{/* Альбом. Нет снимков и нет правки — нет и заголовка: пустых блоков
         страница не рисует. Три квадрата в ряд, по нажатию открывается сам
         файл — своей страницы у фотографии нет, и заводить её ради одного
         снимка значило бы придумать место, на которое некому смотреть. */}}
    {{if or .Photos $e}}
    <div>
      <h2 class="lbl">Альбом{{if $e}} <span class="cnt">{{len .Photos}} из {{$e.Limit}}</span>{{else if .Photos}} <span class="cnt">{{len .Photos}}</span>{{end}}</h2>
      {{if .Photos}}
      <div class="ualbum{{if $e}} own{{end}}">
        {{range .Photos}}
        <figure>
          <a href="{{.URL}}"{{if .Hidden}} class="chid" title="Скрыта модератором"{{end}}>
            <img src="{{.URL}}" alt="" loading="lazy" decoding="async"></a>
          {{/* «Убрать» стои́т ПОД своим снимком: строкой справа она уезжает к
               краю колонки и перестаёт читаться как кнопка ЭТОЙ фотографии. */}}
          {{if $e}}
          <form method="post" action="/me/photo/drop">
            <input type="hidden" name="csrf" value="{{$e.CSRF}}">
            <input type="hidden" name="position" value="{{.Position}}">
            <button type="submit" class="rm">Убрать</button>
          </form>
          {{end}}
        </figure>
        {{end}}
      </div>
      {{end}}
      {{if $e}}
        {{if not $e.Signed}}
        <p class="fine">Фотографии появятся после согласия —
        <a href="/me/about">прочитать и включить</a>.</p>
        {{else if not $e.Shots}}
        <p class="fine">Фотографии сейчас не принимаются: перекодировщик не
        отвечает. Написанное это не трогает.</p>
        {{else if gt $e.Free 0}}
        {{/* Поля файла нет там, где оно заведомо откажет: места кончились или
             перекодировщик не поднялся. Кнопка, отвечающая отказом, хуже её
             отсутствия. Свёрнуто, потому что кладут фотографию раз в полгода,
             а место в колонке она занимала бы всегда. */}}
        <details class="addph">
          <summary>Добавить фотографию</summary>
          <form method="post" action="/me/photo" enctype="multipart/form-data">
            <input type="hidden" name="csrf" value="{{$e.CSRF}}">
            <input type="file" name="shot" accept="image/jpeg,image/png,image/gif,image/webp">
            <button type="submit">Положить</button>
          </form>
          <p class="fine">По одной. Каждую смотрит живой модератор, данные
          съёмки — время, место, камера — снимаются при приёме. Файл лежит по
          открытому адресу: у кого есть ссылка, тот его и увидит.</p>
        </details>
        {{else}}
        <p class="fine">Мест больше нет. Уберите одну, чтобы положить другую.</p>
        {{end}}
        {{if .Photos}}
        <p class="fine">«Убрать» стирает фотографию по-настоящему: файл сносится
        с диска. Это единственное место площадки, где удаление означает
        удаление.</p>
        {{end}}
      {{end}}
    </div>
    {{end}}
  </div>
  <div class="umain">{{template "upubs" .}}</div>
</div>
{{else}}{{template "upubs" .}}{{end}}
{{end}}

{{/* Рассказ о себе и записи — правая колонка, она же вся страница, когда
     справочной части нет. Отдельным шаблоном, а не копией: две копии одного
     списка разошлись бы на первой же правке. */}}
{{define "upubs"}}
{{$m := .Member}}{{$e := .Edit}}

{{if or $m.Persona $m.Bio}}
{{/* Плашка одна на двоих, и различие в ней — одна строка. У ЖИТЕЛЯ биографию
     сочинил оператор, и сказано об этом прямо: всё, что там написано, выдумка,
     у персонажа нет ни персональных данных, ни согласий, которые он мог бы
     подписать, а отвечает за его слова тот, кто его завёл. У ЧЕЛОВЕКА это его
     собственные слова, подписанные отдельным документом, и предупреждать о них
     не за чем.

     Разбирается текст ТЕМ ЖЕ путём, что тело реплики: разметка НГС, смайлы
     площадки, свёртка длинного показом. Второго способа превратить наш текст в
     разметку не заводится нигде — вместе с ним завелась бы вторая поверхность
     XSS. */}}
<div class="ubio">
  {{if $m.Persona}}
  <p class="warn">Это житель площадки: его реплики пишет машина. <a href="/help/narod">Подробнее</a></p>
  {{end}}
  {{if $m.Bio}}<div class="text">{{about $m.Bio}}</div>{{end}}
</div>
{{end}}

{{/* Правка — ЗДЕСЬ, под тем, что она правит, а не на третьей странице.
     Свёрнута, пока рассказывать есть что, и РАСКРЫТА, пока не рассказано
     ничего: пустая страница обязана звать её заполнить, иначе человек и не
     узнает, что город с фотографиями тут вообще бывают.

     details/summary, а не скрипт: без JS форма обязана открываться, как меню
     участника и «Подробнее» у настроек. */}}
{{if $e}}
  {{if $e.Signed}}
  <details class="edit"{{if not (or $m.Bio $m.City $m.Job)}} open{{end}}>
    <summary>{{if or $m.Bio $m.City $m.Job}}Изменить рассказ о себе{{else}}Рассказать о себе{{end}}</summary>
    {{if $e.Bad}}<p class="bad">{{$e.Bad}}</p>{{end}}
    {{if $e.Saved}}<p class="fine">Сохранено.</p>{{end}}
    <p class="fine">Это видно вошедшим участникам на вашей странице. Пустые поля
    не показываются вовсе — заполнять всё сразу не нужно.</p>
    <form method="post" action="/me/about" class="wform">
      <input type="hidden" name="csrf" value="{{$e.CSRF}}">
      <p class="nickform">
        <label for="city">Город</label>
        <input type="text" id="city" name="city" maxlength="64" value="{{$e.About.City}}">
      </p>
      <p class="nickform">
        <label for="job">Занятие</label>
        <input type="text" id="job" name="job" maxlength="64" value="{{$e.About.Job}}">
      </p>
      <label for="bio">О себе</label>
      <textarea id="bio" name="bio" rows="6" maxlength="{{$e.MaxRunes}}">{{$e.About.Bio}}</textarea>
      {{template "smilepick"}}{{template "markpick"}}
      <div class="wact"><button type="submit">Сохранить</button></div>
    </form>
  </details>
  {{else}}
  {{/* Документ ДО кнопки, и потому это ССЫЛКА на свой экран, а не форма здесь:
       подпись, данная мимоходом под полем ввода, подписью не является. */}}
  <div class="edit">
    <p class="fine">Город, занятие, несколько слов о себе и до {{$e.Limit}}
    фотографий. Это необязательно и подписывается отдельным согласием; без него
    площадка работает как прежде.</p>
    <p><a class="btnlink" href="/me/about">Рассказать о себе</a></p>
  </div>
  {{end}}
{{end}}

{{/* Показано ПОСЛЕДНЕЕ, а число у заголовка называет ВСЁ. Прежняя строка
     «Заметок 3 · реплик 412» стояла отдельно от списков и потому могла с ними
     разойтись; теперь число стоит у того списка, к которому относится, а если
     список показан не целиком — об этом сказано под ним словами. Заголовок,
     объясняющий себя всплывающей подписью, на телефоне не объясняет ничего.
     Полную выгрузку отдаёт `platform export` — самому человеку по требованию. */}}
{{if .Notes}}
<h2 class="sub">Заметки <span class="cnt" title="Всего заметок">{{$m.Notes}}</span></h2>
<ul class="upub">
  {{range .Notes}}
  <li><a href="/n/{{.ID}}">{{.Excerpt}}</a>
    <span class="fine">{{when .At .Exact}}{{if .Stage}} · песочница{{end}}</span></li>
  {{end}}
</ul>
{{if .NotesTrimmed}}<p class="fine">Показаны последние {{len .Notes}}.</p>{{end}}
{{end}}

{{if .Comments}}
<h2 class="sub">Реплики <span class="cnt" title="Всего реплик">{{$m.Comments}}</span></h2>
<ul class="upub">
  {{range .Comments}}
  {{/* Ссылка — на саму реплику в треде (#c<id>), а рядом начало заметки: без
       него реплика нечитаема, а один номер заметки не говорит ничего. */}}
  <li><a href="/n/{{.NoteID}}#c{{.ID}}">{{.Excerpt}}</a>
    <span class="fine">{{when .At true}} · в заметке «{{.Note}}»</span></li>
  {{end}}
</ul>
{{if .ComsTrimmed}}<p class="fine">Показаны последние {{len .Comments}}.</p>{{end}}
{{end}}

{{if and (not .Notes) (not .Comments)}}
<p class="fine">Здесь пока ничего не написано.</p>
{{end}}
{{end}}
