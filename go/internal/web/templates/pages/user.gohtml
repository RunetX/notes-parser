{{define "content"}}
{{$m := .Member}}
<section class="uprof">
  {{/* Колонка автора — та же, что у заметки: квадратное фото, имя рядом. Это
       первое, по чему постоянный читатель узнаёт страницу, и заводить здесь
       второй вид карточки значило бы сделать профиль чужим самому себе. */}}
  <div class="uhead">
    <div class="author">{{template "avatar" (av $m.AvatarURL $m.Gender false)}}</div>
    <div class="umeta">
      {{/* Служебная строка стои́т НАД именем: она отвечает на «кто это вообще»
           (участник, житель, тень, обезличенная запись), а имя — на «кто
           именно». Прочитанные в обратном порядке, они заставляют перечитывать
           заголовок. «Здесь с» отсюда уехало в колонку фактов: это справка, а
           не то, чем человек представляется. */}}
      <p class="fine">{{kindword $m}}
        {{- if lt $m.ID 100000000000}} · анкета НГС №{{$m.ID}}{{else}} · №{{$m.ID}}{{end}}
        {{- if eq $m.Role 1}} · модератор{{else if eq $m.Role 2}} · администратор{{end}}</p>
      {{/* Возраст здесь по тому же правилу, что в ленте и в треде: через запятую
           после ника (parts/nick.gohtml). Кеглем он меньше — заголовок называет
           ЧЕЛОВЕКА, а возраст к имени приписка. */}}
      <h1 class="ttl">{{if $m.Nick}}{{$m.Nick}}{{else}}Участник №{{$m.ID}}{{end}}
        {{- if $m.Age}}<span class="age">, {{age $m.Age}}</span>{{end}}</h1>
    </div>
    {{/* «Написать» — вход в переписку, и решает его ОДИН вопрос к ядру
         (CanWriteTo), а не список условий здесь: второй список однажды
         нарисовал бы кнопку, отвечающую отказом.

         Не подписан документ — кнопка не пропадает, а ведёт к нему: спрятанная
         кнопка ничего не объясняет. Закрыта переписка чёрным списком — вместо
         кнопки стои́т ПРИЧИНА, и стои́т она ниже, во всю ширину: это не действие,
         а объяснение, и прижимать его к правому краю не за чем. */}}
    {{if .MailTo}}<p class="uact"><a class="btnlink" href="{{.MailTo}}">Написать</a></p>{{end}}
  </div>

  {{/* Ниже и во всю ширину — то, что про СОСТОЯНИЕ человека, а не про его
       рассказ о себе: запрет писать, решения модератора, своя страница. В
       колонку 220px формы решений не встают физически, а мотать до них через
       двадцать чужих реплик модератору незачем. */}}
  {{if and (not .MailTo) .MailWhy}}
  <p class="fine">{{.MailWhy}}</p>
    {{/* Свой запрет снимается тут же: отсылать человека на другую страницу за
         кнопкой, которую можно поставить сюда, значит добавить переход и повод
         забыть, зачем шёл. Чужой запрет кнопки не даёт вовсе — снять его нельзя
         ничем. */}}
    {{if .MailUnblock}}
    <form method="post" action="/mail/unblock" class="avaform">
      <input type="hidden" name="csrf" value="{{.CSRF}}">
      <input type="hidden" name="to" value="{{$m.ID}}">
      <input type="hidden" name="back" value="/u/{{$m.ID}}">
      <button type="submit">Снять запрет</button>
    </form>
    {{end}}
  {{end}}

  {{if .Banned}}
  <p class="warn">Публикации запрещены до {{when $m.BannedUntil true}}.
  {{if $m.BanReason}}Причина: {{$m.BanReason}}{{end}}</p>
  {{end}}

  {{if and .CanModerate (not .Me)}}{{template "moddec" (udec .)}}{{end}}
  {{if .Me}}<p class="fine">Это ваша страница. Ник, фото и согласия — на <a href="/me">«Моей странице»</a>.</p>{{end}}

  {{/* Две колонки. Обе половины сетки рисуются вместе или не рисуются вовсе
       (.HasSide считается в Go): .ucols без .uside положил бы записи в колонку
       шириной 220px, и страница схлопнулась бы в полосу. */}}
  {{if .HasSide}}
  <div class="ucols">
    <div class="uside">
      {{/* Каждый блок колонки — в своей обёртке: отступ между ними ставит
           правило соседства (.uside > * + *), а у самого ярлыка margin-top
           нулевой — иначе «АЛЬБОМ» прилипает к последней строке фактов. */}}
      {{if .Facts}}
      <div>
        <h2 class="lbl">О себе</h2>
        <dl class="ufacts">
          {{range .Facts}}<dt>{{.K}}</dt><dd>{{.V}}</dd>{{end}}
        </dl>
      </div>
      {{end}}
      {{/* Альбом. Нет снимков — нет и заголовка: пустых блоков страница не
           рисует. Три квадрата в ряд, по нажатию открывается сам файл — своей
           страницы у фотографии нет, и заводить её ради одного снимка значило
           бы придумать место, на которое некому смотреть. */}}
      {{if .Photos}}
      <div>
        <h2 class="lbl">Альбом <span class="cnt">{{len .Photos}}</span></h2>
        <div class="ualbum">
          {{range .Photos}}
          <a href="{{.URL}}"{{if .Hidden}} class="chid" title="Скрыта модератором"{{end}}>
            <img src="{{.URL}}" alt="" loading="lazy" decoding="async"></a>
          {{end}}
        </div>
      </div>
      {{end}}
    </div>
    <div class="umain">{{template "upubs" .}}</div>
  </div>
  {{else}}{{template "upubs" .}}{{end}}
</section>
{{end}}

{{/* Рассказ о себе и записи — правая колонка, она же вся страница, когда
     справочной части нет. Отдельным шаблоном, а не копией: две копии одного
     списка разошлись бы на первой же правке. */}}
{{define "upubs"}}
{{$m := .Member}}
{{if .AboutHidden}}
<p class="warn">Карточка скрыта модератором: рассказ, город, занятие и
фотографии видите только вы и модератор.</p>
{{end}}

{{if or $m.Persona $m.Bio}}
{{/* Плашка одна на двоих, и различие в ней — одна строка. У ЖИТЕЛЯ биографию
     сочинил оператор, и сказано об этом прямо: всё, что там написано, выдумка,
     у персонажа нет ни персональных данных, ни согласий, которые он мог бы
     подписать, а отвечает за его слова тот, кто его завёл. У ЧЕЛОВЕКА это его
     собственные слова, подписанные отдельным документом, и предупреждать о них
     не за чем.

     Разбирается текст ТЕМ ЖЕ путём, что тело реплики: разметка НГС, смайлы
     площадки, свёртка длинного показом. Второго способа превратить наш текст в
     разметку не заводится нигде — вместе с ним завелась бы вторая поверхность
     XSS. */}}
<div class="ubio">
  {{if $m.Persona}}
  <p class="warn">Это житель площадки: его реплики пишет машина. <a href="/help/narod">Подробнее</a></p>
  {{end}}
  {{if $m.Bio}}<div class="text">{{about $m.Bio}}</div>{{end}}
</div>
{{end}}

{{/* Показано ПОСЛЕДНЕЕ, а число у заголовка называет ВСЁ. Прежняя строка
     «Заметок 3 · реплик 412» стояла отдельно от списков и потому могла с ними
     разойтись; теперь число стоит у того списка, к которому относится, а если
     список показан не целиком — об этом сказано под ним словами. Заголовок,
     объясняющий себя всплывающей подписью, на телефоне не объясняет ничего.
     Полную выгрузку отдаёт `platform export` — самому человеку по требованию. */}}
{{if .Notes}}
<h2 class="sub">Заметки <span class="cnt" title="Всего заметок">{{$m.Notes}}</span></h2>
<ul class="upub">
  {{range .Notes}}
  <li><a href="/n/{{.ID}}">{{.Excerpt}}</a>
    <span class="fine">{{when .At .Exact}}{{if .Stage}} · песочница{{end}}</span></li>
  {{end}}
</ul>
{{if .NotesTrimmed}}<p class="fine">Показаны последние {{len .Notes}}.</p>{{end}}
{{end}}

{{if .Comments}}
<h2 class="sub">Реплики <span class="cnt" title="Всего реплик">{{$m.Comments}}</span></h2>
<ul class="upub">
  {{range .Comments}}
  {{/* Ссылка — на саму реплику в треде (#c<id>), а рядом начало заметки: без
       него реплика нечитаема, а один номер заметки не говорит ничего. */}}
  <li><a href="/n/{{.NoteID}}#c{{.ID}}">{{.Excerpt}}</a>
    <span class="fine">{{when .At true}} · в заметке «{{.Note}}»</span></li>
  {{end}}
</ul>
{{if .ComsTrimmed}}<p class="fine">Показаны последние {{len .Comments}}.</p>{{end}}
{{end}}

{{if and (not .Notes) (not .Comments)}}
<p class="fine">Здесь пока ничего не написано.</p>
{{end}}
{{end}}
