{{define "content"}}
{{/* Документ ПРЕЖДЕ кнопки, и это единственное, что осталось на этом адресе:
     формы переехали на «Мою страницу», туда же, где виден их результат. Тот же
     экран и та же разметка, что у привязки мессенджера и у согласия на
     переписку — три экрана одного разговора не должны выглядеть по-разному. */}}
<section class="enterbox doc">
  <div class="doctext">{{doc .Doc.Body}}</div>

  <form method="post" action="/me/about/consent" class="agree">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <button type="submit">Согласен — рассказать о себе</button>
  </form>

  <p class="fine">Согласие необязательное: без него площадка работает как
  прежде. После подписи город, занятие, рассказ и фотографии правятся прямо на
  «Моей странице». Отозвать согласие можно там же, во вкладке «Настройки», —
  тогда всё написанное и все фотографии убираются, а файлы сносятся с диска.</p>

  <p class="alt"><a href="/me">Вернуться на мою страницу</a></p>
</section>
{{end}}
