{{define "content"}}
{{$n := .Note}}
<div class="nblock">
  {{/* Переключатель вида — в правом верхнем углу блока заметки, как на НГС.
       Две ссылки, а не кнопки: без JS он обязан работать так же.

       Иконками, а не словами, и это тоже с оригинала: там два ПУСТЫХ <a> с
       одним title, картинку рисует CSS. Словами он занимал 150 px ширины, и
       на телефоне с крупным системным шрифтом (viewport 288 px) под текст
       заметки оставалось два знака в строке — жалоба 18.08.2026.

       Значки нарисованы здесь, а не картинкой в CSS: цвет берётся из
       currentColor, поэтому состояние «выбрано» и тема меняют их даром. */}}
  <nav class="switch">
    <a class="sw tree{{if not .Linear}} on{{end}}" href="{{.TreeURL}}"
       title="Древовидный вид комментариев" aria-label="Древовидный вид комментариев">
      <svg class="ico" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
        <rect x="1" y="2" width="14" height="2.4" rx="1.2"/>
        <rect x="5" y="6.8" width="10" height="2.4" rx="1.2"/>
        <rect x="9" y="11.6" width="6" height="2.4" rx="1.2"/>
      </svg>
    </a>
    <a class="sw lin{{if .Linear}} on{{end}}" href="{{.FlatURL}}"
       title="Линейный вид комментариев" aria-label="Линейный вид комментариев">
      <svg class="ico" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
        <rect x="1" y="2" width="14" height="2.4" rx="1.2"/>
        <rect x="1" y="6.8" width="14" height="2.4" rx="1.2"/>
        <rect x="1" y="11.6" width="14" height="2.4" rx="1.2"/>
      </svg>
    </a>
  </nav>
  {{/* Скрытая заметка ЗАТЕНЯЕТСЯ, а не исчезает, — но видит её только модератор
       (страница отвечает всем остальным «такой заметки нет»). Класс тот же по
       смыслу, что у скрытой реплики: nhid к chid, и правило в CSS у них общее. */}}
  <div class="note notebox{{if ne $n.Status 0}} nhid{{end}}">
    <div class="author">
      {{template "avatar" (av $n.Author.AvatarURL $n.Author.Gender $n.Anonymous)}}
      <span class="nick {{$n.Author.Gender.Class}}{{if $n.Anonymous}} anon{{end}}">{{$n.Name}}</span>
    </div>
    <div class="nbody">
      <div class="text">{{body $n}}</div>
      {{/* Ролики идут ПЕРЕД иллюстрациями: картинку к заметке приложил сайт, а
           ролик назвал сам автор в тексте — и стоять он должен там, где о нём
           сказано. */}}
      {{template "videos" (vid $n.ID $n.Body)}}
      {{if .Images}}
      <div class="shots">
        {{range .Images}}{{if .URL}}
        <a href="{{.URL}}"><img src="{{.URL}}" alt="Иллюстрация к заметке"{{if .Width}} width="{{.Width}}" height="{{.Height}}"{{end}} loading="lazy" decoding="async"></a>
        {{end}}{{end}}
      </div>
      {{end}}
      {{template "reactions" (rx $ 0)}}
      <div class="nfoot">
        {{when $n.PublishedAt $n.PublishedExact}}
        {{with origin $n.ID}}<span class="orig" title="{{.Title}}">{{template "ico-origin" .Icon}}<span class="sr-only">{{.Label}}</span></span>{{end}}
        {{/* «Исправлено» стоит рядом с датой, а не вместо неё: текст под уже
             написанными ответами изменился, и читатель обязан узнать об этом со
             страницы, а не из сравнения с памятью. Метки этой на НГС не было —
             там и правки не было, — поэтому по правилу Ш5з она объясняет себя
             сама, заголовком при наведении. */}}
        {{if $n.EditedAt}}<span class="edited" title="Текст заметки правили после публикации">исправлено</span>{{end}}
        {{/* Ссылка на правку живёт ровно столько, сколько окно: десять минут,
             одна правка и до первого ответа. Условие считает Editable — то же
             самое, что проверит ядро, чтобы кнопка не отвечала отказом.

             У администратора окна нет, и его «Поправить» стоит не здесь, а в
             полоске модерации: это право не авторское, и место ему рядом с
             остальными решениями о чужом тексте. */}}
        {{if .Editable}}<a class="editlink" href="/n/{{$n.ID}}/edit">Поправить</a>{{end}}
      </div>
      {{/* Замок, закрепление и правка администратора стоят ВНУТРИ этой полоски
           (parts/modbar.gohtml): один шаблон и на странице, и в ленте — иначе
           набор кнопок в двух местах разъехался бы на первой же правке. */}}
      {{template "modbar" (modn $)}}
    </div>
  </div>
</div>

{{/* Замок и отметка НГС «не актуальна» — разные вещи, и на СТРАНИЦЕ их стоит
     различать: здесь человек собирается писать, и ему важно, кто закрыл дверь.
     В ленте они выглядят одинаково — там вопрос другой, «стоит ли заходить». */}}
<h2 class="cttl" id="comments">Комментарии <span class="cnt">{{$n.CommentCount}}</span>
{{- if $n.Locked}} <span class="closed">Обсуждение закрыто модератором</span>
{{- else if $n.CommentsClosed}} <span class="closed">Комментарии запрещены</span>{{end}}</h2>

{{if not .Comments}}
<p class="empty">Комментариев пока нет.</p>
{{end}}

{{/* data-fresh — граница живого добора: реплики новее этой страница дописывает
     сама, без перезагрузки (assets/app.js). Атрибут и есть выключатель: там,
     где его нет, дописывать нельзя — так на страницах линейного вида, кроме
     первой, потому что они исторический срез, а не хвост разговора.

     data-jump — «проматывать к новым» (jump.go): встать на пришедшую реплику,
     а не только подсветить её. Стоит рядом с добором и внутри того же if:
     прыгать некуда там, где ничего не дописывается. */}}
<ul class="thread{{if .Linear}} linear{{end}}"
    {{- if .FreshOK}} data-fresh="{{.FreshAfter}}" data-fresh-url="/n/{{$n.ID}}/fresh"{{if .Jump}} data-jump="1"{{end}}{{end}}>
{{range .Comments}}
  {{template "comment" (ci $ .)}}
  {{/* Форма стоит ПОД той репликой, которой отвечают, а не внизу страницы:
       нажатие «Ответить» уводило в самый низ треда, и оттуда приходилось
       листать обратно к месту разговора (жалоба владельца 23.08.2026). Место
       выбирает сервер, а не скрипт, — иначе без JS осталась бы прежняя дорога.

       Со скриптом та же строка приезжает без перезагрузки (replyform.go), и
       рисует её этот же шаблон — потому он и вынесен в часть. */}}
  {{if and $.ReplyTo (eq .ID $.ReplyTo.ID)}}{{template "replyrow" $}}{{end}}
{{end}}
</ul>

{{template "pager" .Pager}}

{{/* Внизу форма остаётся для ответа НА ЗАМЕТКУ (и для случая, когда адресат
     остался на другой странице линейного вида): там ей и место — она про весь
     тред, а не про чью-то реплику. */}}
{{if not .ReplyTo}}{{template "reply" .}}{{end}}
{{end}}
