{{define "content"}}
{{$m := .Prof.Member}}
<section class="uprof">
{{template "metabs" "profile"}}

{{if .Problem}}<p class="warn">{{.Problem}}</p>{{end}}

{{/* Шапка — ТА ЖЕ, что у чужой страницы (.uhead): квадратное фото слева, имя
     рядом, служебная строка над ним. Две страницы про одного человека обязаны
     выглядеть страницами одного человека; здесь к этому добавлены только
     кнопки, которых у постороннего быть не может. */}}
<div class="uhead">
  <div class="author">{{template "avatar" (av $m.AvatarURL $m.Gender false)}}</div>
  <div class="umeta">
    <p class="fine">{{kindword $m}}
      {{- if lt $m.ID 100000000000}} · анкета НГС №{{$m.ID}}{{else}} · №{{$m.ID}}{{end}}
      {{- if eq $m.Role 1}} · модератор{{else if eq $m.Role 2}} · администратор{{end}}
      {{- if and (not $m.AnonymizedAt) (not $m.CreatedAt.IsZero)}} · здесь с {{when $m.CreatedAt false}}{{end}}</p>
    <h1 class="ttl">{{if $m.Nick}}{{$m.Nick}}{{else}}Участник №{{$m.ID}}{{end}}
      {{- if $m.Age}}<span class="age">, {{age $m.Age}}</span>{{end}}</h1>
    {{/* Кнопка, а не форма загрузки: аватара из своего файла площадка не
         принимает — он стои́т под каждой репликой за тринадцать лет, а тут
         перенос того, что человек и так показывает на НГС. */}}
    <div class="avarow">
      {{if .Avatar}}
      <form method="post" action="/me/avatar" class="avaform">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <button type="submit">Обновить аватар</button>
      </form>
      {{end}}
      {{/* «Убрать фото» — вторая дорога, и появилась она из тупика: соседняя
           кнопка пустую анкету НГС за причину снять фото не считает, поэтому
           стёрший фото ТАМ оставался здесь с прежним навсегда. Показывается,
           когда снимать есть что, и не зависит ни от живости НГС, ни от полосы
           id: этот путь на чужой сайт не ходит вовсе. */}}
      {{if $m.AvatarURL}}
      <form method="post" action="/me/avatar/clear" class="avaform">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <button type="submit">Убрать фото</button>
      </form>
      {{end}}
      {{/* Смена ника — не публикация, поэтому под правило «участник только
           пишет» она не попадает: площадка на переименование рассчитана, ник
           хранится ТЕКУЩИЙ и дорисовывается везде, включая обращения к вам в
           чужих ответах. Стои́т рядом с кнопками фото: это всё одно и то же —
           «как меня зовут и как я выгляжу». Свёрнуто, потому что ник меняют
           раз в год, а поле ввода под именем стояло бы всегда. */}}
      <details class="edit">
        <summary>Сменить ник</summary>
        <form method="post" action="/me/nick" class="nickform">
          <input type="hidden" name="csrf" value="{{.CSRF}}">
          <label for="nick">Ник</label>
          <input id="nick" name="nick" value="{{$m.Nick}}" maxlength="40" required>
          <button type="submit">Сменить</button>
        </form>
        <p class="fine">Ник меняется везде и задним числом — и в старых
        заметках, и в обращениях к вам в чужих ответах. Выбранный здесь ник
        больше не переписывается из анкеты НГС при входе.</p>
        {{if or .Avatar $m.AvatarURL}}
        <p class="fine">Фото берётся из вашей анкеты на НГС: само оно сюда
        больше не приезжает — раньше его приносило зеркало вместе с вашими
        комментариями, а комментарии на НГС не принимаются с 17 августа.
        «Убрать фото» снимает его отсюда, но пока оно стои́т в анкете, его
        вернёт первый же ваш комментарий оттуда.</p>
        {{end}}
      </details>
    </div>
  </div>
  {{/* Ссылка на ту же страницу глазами постороннего. Нужна не для красоты:
       здесь видно СВОЁ — скрытое модератором, снятые снимки, — и «а что видят
       другие» отвечается только переходом. */}}
  <p class="uact"><a class="btnlink" href="/u/{{$m.ID}}">Как видят другие</a></p>
</div>


{{/* Запрет писать показывается ЗДЕСЬ, а не выкидывает из учётной записи: чтение
     на площадке открыто всем, и выкинув человека, мы отняли бы у него ровно ту
     строку, где написано, за что и до какого числа. */}}
{{if .Ban}}
<p class="warn">Публикации вам запрещены до {{when .Ban true}}.
{{if .Reason}}Причина: {{.Reason}}{{end}}
Читать и ставить реакции можно как обычно.</p>
{{end}}

{{template "profile" .Prof}}

{{/* Скрытое модерацией — со СВОЕЙ причиной и кнопкой «на пересмотр». Молча
     исчезнувшая реплика — худшее, что можно сделать с сообществом, которое
     только что переехало; автомат ошибается, и дорога назад обязана быть.
     Стои́т после записей: это про них же, и читать его раньше самих записей
     незачем. */}}
{{if .Hidden}}
<h2 class="sub">Скрыто модерацией</h2>
<ul class="myhid">
{{range .Hidden}}
  <li class="mitem">
    <div class="mhead">
      <a class="mlink" href="/n/{{.NoteID}}">{{if eq .Subject.Kind "note"}}ваша заметка{{else}}ваш комментарий{{end}}</a>
      <span class="fine">{{when .HiddenAt true}}</span>
      {{if .ByMachine}}<span class="mtag">решение автомата</span>{{end}}
    </div>
    <div class="mwhy"><b>{{.CategoryTitle}}</b>{{if .Reason}} — {{.Reason}}{{end}}</div>
    <div class="mtext">{{.Body}}</div>
    {{if .CanAppeal}}
    <form method="post" action="/appeal" class="minline">
      <input type="hidden" name="csrf" value="{{$.CSRF}}">
      <input type="hidden" name="kind" value="{{.Subject.Kind}}">
      <input type="hidden" name="id" value="{{.Subject.ID}}">
      <button type="submit" class="mbtn">Просить пересмотра человеком</button>
    </form>
    {{else if .Appealed}}
    <p class="fine">Пересмотр запрошен — ждёт модератора.</p>
    {{else}}
    <p class="fine">Решение принял человек. Пересмотреть его ещё раз кнопкой нельзя.</p>
    {{end}}
  </li>
{{end}}
</ul>
{{end}}
</section>
{{end}}
