{{define "content"}}
<h1 class="ttl">Моя страница</h1>

{{if .Problem}}<p class="warn">{{.Problem}}</p>{{end}}

{{/* Шапка собрана как у профиля (.uhead): служебная
     строка НАД именем, имя заголовком. Две страницы про одного человека, и
     выглядеть они обязаны страницами одного человека — иначе переход между
     ними читается как переход в другое место. */}}
<div class="uhead">
  <div class="author">{{template "avatar" (av .Member.AvatarURL .Member.Gender false)}}</div>
  <div class="umeta">
    <p class="fine">
      {{if lt .Member.ID 100000000000}}анкета НГС №{{.Member.ID}}{{else}}участник №{{.Member.ID}}{{end}}
      {{if .AdminRole}} · администратор{{end}}
    </p>
    <p class="nick {{.Member.Gender.Class}}">{{.Member.Nick}}</p>
    {{/* Кнопка, а не форма загрузки: своего файла площадка не принимает вовсе —
         это премодерация, хранилище и другой разговор о согласии (Ш5д). Здесь
         перенос того, что человек и так показывает на НГС. */}}
    <div class="avarow">
      {{if .Avatar}}
      <form method="post" action="/me/avatar" class="avaform">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <button type="submit">Обновить аватар</button>
      </form>
      {{end}}
      {{/* «Убрать фото» — вторая дорога, и появилась она из тупика: соседняя
           кнопка пустую анкету НГС за причину снять фото не считает, поэтому
           стёрший фото ТАМ оставался здесь с прежним навсегда. Показывается,
           когда снимать есть что, и не зависит ни от живости НГС, ни от полосы
           id: этот путь на чужой сайт не ходит вовсе. */}}
      {{if .Member.AvatarURL}}
      <form method="post" action="/me/avatar/clear" class="avaform">
        <input type="hidden" name="csrf" value="{{.CSRF}}">
        <button type="submit">Убрать фото</button>
      </form>
      {{end}}
    </div>
  </div>
  {{/* Ссылка на СВОЮ страницу участника — в правом краю шапки, там же, где у
       чужой страницы стои́т «Написать». До 12.09.2026 её здесь не было вовсе,
       и человек, искавший «свой профиль», видел один этот список настроек. */}}
  <p class="uact"><a class="btnlink" href="/u/{{.Member.ID}}">Мой профиль — как видят другие</a></p>
</div>

{{/* Объяснения убраны под «Подробнее», и это не косметика: страница отвечает
     сразу на десяток вопросов, и распечатанные подряд абзацы прятали САМИ
     настройки — до нижних приходилось мотать через полтора экрана прозы.
     details/summary, а не скрипт: без JS оно обязано открываться, как и меню
     участника. */}}
{{if or .Avatar .Member.AvatarURL}}
<details class="why">
  <summary>Откуда здесь фото и как его сменить</summary>
  {{if .Avatar}}
  <p class="fine">Фото берётся из вашей анкеты на НГС. Само оно сюда больше не
  приезжает: раньше его приносило зеркало вместе с вашими комментариями, а
  комментарии на НГС не принимаются с 17 августа. Сменили фото в анкете —
  нажмите «Обновить аватар», и здесь оно станет таким же. Если в анкете фото
  нет, прежнее останется на месте.</p>
  {{end}}
  {{if .Member.AvatarURL}}
  <p class="fine">«Убрать фото» снимает его отсюда — на этом месте останется
  силуэт. Но пока фото стоит в анкете НГС, его вернёт первый же ваш комментарий,
  приехавший оттуда: зеркало приносит аватар вместе с репликой. Чтобы не
  возвращалось, уберите его и в анкете.</p>
  {{end}}
</details>
{{end}}

{{/* Смена ника — не публикация, поэтому под правило «участник только пишет» она
     не попадает. Площадка на переименование рассчитана: ник хранится ТЕКУЩИЙ и
     дорисовывается везде, включая обращения к вам в чужих ответах, — а текст
     согласия обещает эту возможность прямо. */}}
<form method="post" action="/me/nick" class="nickform">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <label for="nick">Ник</label>
  <input id="nick" name="nick" value="{{.Member.Nick}}" maxlength="40" required>
  <button type="submit">Сменить</button>
</form>
<p class="fine">Ник меняется везде и задним числом — и в старых заметках, и в
обращениях к вам в чужих ответах. Выбранный здесь ник больше не переписывается
из анкеты НГС при входе.</p>

{{/* Рассказ о себе и фотографии — эпик M. Пишут и грузят их на СВОЕЙ странице
     (/me/about): там подписывают документ, а подпись, данная мимоходом под
     кнопкой в этом длинном списке, подписью не является.

     А вот ПОКАЗЫВАТЬ написанное надо здесь. Первая редакция оставила тут одну
     кнопку с двумя фразами объяснения — и раздел, о котором говорит одна
     кнопка, человек попросту не находит (12.09.2026, замечание владельца: «ты
     ничего не сказал, как пользователь загружает свои три фото»). Теперь видно
     состояние: что заполнено, сколько фотографий из трёх и сколько мест
     осталось, — а подпись кнопки выводится из этого же. */}}
{{/* Счётчика у заголовка тут НЕТ, в отличие от страницы участника: там число
     называет обрезанный список, а здесь показано всё, и «О себе 3» читается
     загадкой — три чего. Сколько фотографий и сколько мест осталось, сказано
     строкой под альбомом словами. */}}
<h2 class="sub">О себе</h2>

{{if .AboutHidden}}
<p class="warn">Карточку скрыл модератор: город, занятие, рассказ и фотографии
сейчас видите только вы. Написать ему можно со страницы <a href="/report">жалоб
и обращений</a>.</p>
{{end}}

{{if or .About.City .About.Job .About.Bio .Photos}}
<dl class="ufacts">
  {{if .About.City}}<dt>Город</dt><dd>{{.About.City}}</dd>{{end}}
  {{if .About.Job}}<dt>Занятие</dt><dd>{{.About.Job}}</dd>{{end}}
</dl>
{{if .About.Bio}}<div class="ubio"><div class="text">{{about .About.Bio}}</div></div>{{end}}
{{if .Photos}}
<div class="ualbum mealbum">
  {{range .Photos}}
  <a href="{{.URL}}"{{if .Hidden}} class="chid" title="Скрыта модератором"{{end}}>
    <img src="{{.URL}}" alt="" loading="lazy" decoding="async"></a>
  {{end}}
</div>
{{end}}
<p class="fine">Фотографий {{len .Photos}} из {{.PhotoLimit}}{{if .PhotoFree}},
  свободн{{if eq .PhotoFree 1}}о место{{else}}о мест{{end}} {{.PhotoFree}}{{end}}.
  Всё это видно вошедшим участникам в <a href="/u/{{.Member.ID}}">вашем
  профиле</a>.</p>
<p><a class="btnlink" href="/me/about">Изменить</a></p>
{{else}}
<p class="fine">Город, занятие, несколько слов о себе и до {{.PhotoLimit}} фотографий.
Это необязательно и подписывается отдельным согласием; без него площадка
работает как прежде. Фотографии принимаются по одной, каждую смотрит живой
модератор, данные съёмки снимаются при приёме.</p>
<p><a class="btnlink" href="/me/about">Рассказать о себе</a></p>
{{end}}

{{if .NGSSendable}}
{{/* Вынос написанного на love.ngs.ru. Устроено как «Проматывать к новым»:
     состояние словом, кнопка — действием.

     А вот CSRF здесь ОБЯЗАТЕЛЕН, в отличие от соседа: подделанное нажатие там
     меняло бы прокрутку у самого пострадавшего, а здесь — начало бы уносить его
     слова на чужой сайт под его именем. Это не настройка экрана, а согласие. */}}
<div class="pref">
  <div>
    <b>Отправлять мои записи на НГС</b>
    <span class="fine">сейчас {{if .NGSSend}}включено{{else}}выключено{{end}}</span>
  </div>
  <form method="post" action="/me/ngssend">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <input type="hidden" name="on" value="{{if .NGSSend}}0{{else}}1{{end}}">
    <button type="submit">{{if .NGSSend}}Выключить{{else}}Включить{{end}}</button>
  </form>
</div>
{{/* Галочка стоит, а записи не уходят — и человеку об этом надо СКАЗАТЬ.
     Сессия сайта живёт у демона, в его SQLite, и морда о ней узнать не может
     вовсе; зато она видит СЛЕД, оставленный демоном в очереди: строки, снятые
     по причине «нет сессии». Отсюда и слова: не «сессия истекла», а
     «столько-то записей не ушло» — страница говорит о том, что видит.

     Оплачено живым случаем 02.09.2026: семь ответов участницы легли в skipped
     подряд, и узнать об этом ей было неоткуда. Гаснет строка сама — считается
     только пока ПОСЛЕДНЯЯ строка очереди такая же (platform.NGSStuck). */}}
{{if .NGSStuck}}
<p class="warn">На НГС не ушло {{.NGSStuck}} {{plural .NGSStuck "запись" "записи" "записей"}}
— начиная с {{when .NGSStuckAt true}}. Причина не в них: у нас нет живой сессии
сайта от вашего имени. Войдите в РюмкинЪ командой <code>/login</code>, и
следующие записи поедут. Пропущенные очередь не переигрывает — их придётся
написать на сайте руками.</p>
{{end}}
{{if .NGSPending}}
<p class="warn">{{.NGSPending}} {{plural .NGSPending "заметка отправлена" "заметки отправлены" "заметок отправлено"}}
на НГС и ещё не {{plural .NGSPending "вернулась" "вернулись" "вернулись"}} сюда. Обычно это занимает
около минуты: заметку приносит то же зеркало, что и чужие.</p>
{{end}}
<details class="why">
  <summary>Что меняет эта настройка</summary>
<p class="fine">Выключено по умолчанию: публикуя здесь, вы соглашались на
публикацию здесь. С включённой настройкой <b>ваша новая заметка публикуется не
здесь, а на love.ngs.ru</b> — от вашего имени, вашей же сессией сайта, — и
приезжает сюда обратно вместе со своим обсуждением, как любая заметка оттуда.
Так у неё один текст, один адрес и один разговор на обе половины сообщества:
отвечать смогут и там, и тут.</p>
<p class="fine">Что из этого следует. Заметка появляется в ленте <b>не сразу</b>,
примерно через минуту. Править её в первые десять минут будет нельзя — правка
есть только у написанного здесь. Если сайт не ответит или вы не вошли в РюмкинЪ
(команда <code>/login</code>), заметка опубликуется <b>здесь</b>: текст не
пропадёт в любом случае. Заметка с картинкой и заметка в песочнице остаются
здесь всегда — картинку наш клиент сайта отправить не умеет.</p>
<p class="fine">Ответы работают иначе и как раньше: ответ под заметкой с НГС
уходит на сайт, ответ под заметкой, написанной здесь, остаётся здесь — на сайте
такой заметки нет вовсе. Анонимная заметка уходит АНОНИМНОЙ и там: маску ставит
сам НГС, вашего имени под ней не появится. Уже написанное настройка не трогает,
только новое. Убрать оттуда отправленное можно лишь на самом НГС.</p>
<p class="fine">И одно, о чём лучше знать заранее: <b>ваша заметка, уехавшая на
НГС, живёт там своей жизнью</b>. Здесь она остаётся ровно той, что вы написали,
со своим обсуждением, а то, что вам ответят на сайте, сюда не приедет —
заглядывать за ответами придётся туда. С ответами наоборот: их вы пишете под
заметкой, которая на НГС уже есть, и разговор в ней общий.</p>
</details>
{{end}}

{{/* «Проматывать к новым» (jump.go). Состояние названо СЛОВОМ, а кнопка —
     действием: подпись «Проматывать к новым» на выключенной настройке читается
     и как «сейчас так», и как «сделать так», и различить их нечем.

     CSRF у формы нет намеренно — как и у смены темы: подделанное нажатие меняет
     одну лишь прокрутку у самого пострадавшего, а чужую страницу отсекает
     проверка источника. */}}
<div class="pref">
  <div>
    <b>Проматывать к новым</b>
    <span class="fine">сейчас {{if .Jump}}включено{{else}}выключено{{end}}</span>
  </div>
  <form method="post" action="/me/jump">
    <input type="hidden" name="on" value="{{if .Jump}}0{{else}}1{{end}}">
    <button type="submit">{{if .Jump}}Выключить{{else}}Включить{{end}}</button>
  </form>
</div>
<details class="why">
  <summary>Что меняет эта настройка</summary>
<p class="fine">Пока заметка открыта, новые реплики дописываются в неё сами. Без
этой настройки новое только подсвечивается — а в дереве реплика садится в свою
ветку, то есть где угодно, в том числе выше прочитанного и за краем экрана.
С ней страница встаёт на пришедшую реплику сама. Пока вы набираете ответ или
что-то выделили, она никуда не прыгает. Настройка живёт в этом браузере: на
другом устройстве её надо включить заново.</p>
</details>

{{/* Запрет писать показывается ЗДЕСЬ, а не выкидывает из учётной записи: чтение
     на площадке открыто всем, и выкинув человека, мы отняли бы у него ровно ту
     строку, где написано, за что и до какого числа. */}}
{{if .Ban}}
<p class="warn">Публикации вам запрещены до {{when .Ban true}}.
{{if .Reason}}Причина: {{.Reason}}{{end}}
Читать и ставить реакции можно как обычно.</p>
{{end}}

{{/* Скрытое модерацией — со СВОЕЙ причиной и кнопкой «на пересмотр». Молча
     исчезнувшая реплика — худшее, что можно сделать с сообществом, которое
     только что переехало; автомат ошибается, и дорога назад обязана быть. */}}
{{if .Hidden}}
<h2 class="sub">Скрыто модерацией</h2>
<ul class="myhid">
{{range .Hidden}}
  <li class="mitem">
    <div class="mhead">
      <a class="mlink" href="/n/{{.NoteID}}">{{if eq .Subject.Kind "note"}}ваша заметка{{else}}ваш комментарий{{end}}</a>
      <span class="fine">{{when .HiddenAt true}}</span>
      {{if .ByMachine}}<span class="mtag">решение автомата</span>{{end}}
    </div>
    <div class="mwhy"><b>{{.CategoryTitle}}</b>{{if .Reason}} — {{.Reason}}{{end}}</div>
    <div class="mtext">{{.Body}}</div>
    {{if .CanAppeal}}
    <form method="post" action="/appeal" class="minline">
      <input type="hidden" name="csrf" value="{{$.CSRF}}">
      <input type="hidden" name="kind" value="{{.Subject.Kind}}">
      <input type="hidden" name="id" value="{{.Subject.ID}}">
      <button type="submit" class="mbtn">Просить пересмотра человеком</button>
    </form>
    {{else if .Appealed}}
    <p class="fine">Пересмотр запрошен — ждёт модератора.</p>
    {{else}}
    <p class="fine">Решение принял человек. Пересмотреть его ещё раз кнопкой нельзя.</p>
    {{end}}
  </li>
{{end}}
</ul>
{{end}}

{{/* КАК ВЫ ВХОДИТЕ — раздел про двери, а не про данные, и потому он стоит выше
     согласий: человек приходит сюда чаще всего именно с этим вопросом.

     Дверей у площадки четыре, но природы у них две. Код в поле «о себе» и ссылка
     из бота доказывают право ОДНИМ И ТЕМ ЖЕ — живой анкетой на НГС, и
     закрываются они разом, вместе с анкетой. Привязанный мессенджер от чужого
     сайта не зависит вовсе, поэтому он здесь назван отдельной строкой, а не
     мелким шрифтом под остальными. */}}
<h2 class="sub">Как вы входите</h2>
<ul class="doors">
  <li>
    {{if .NGSDoor}}<b>Анкета на НГС №{{.Member.ID}}</b> —
      {{if .SiteUp}}вход по коду в поле «о себе».
      {{else}}вход по коду сейчас не работает: НГС не отвечает нашему серверу.{{end}}
    {{else}}<b>Анкеты на НГС у вас нет</b> — вход по коду вам не работает.{{end}}
  </li>
{{range .Bindings}}
  <li>
    <b>{{msgname .Messenger}}</b> — привязан {{when .VerifiedAt true}}.
    <form method="post" action="/me/unbind" class="avaform">
      <input type="hidden" name="csrf" value="{{$.CSRF}}">
      <input type="hidden" name="messenger" value="{{.Messenger}}">
      <button type="submit" class="danger">Отвязать</button>
    </form>
  </li>
{{end}}
</ul>

<p><a class="btnlink" href="/me/bind">Привязать мессенджер</a></p>

<p class="fine">Привязанный мессенджер — это способ вернуть вход, когда анкеты
НГС не стало: бот узнаёт вас в личном разговоре и выдаёт одноразовую ссылку.
Привязать можно и Telegram, и MAX — это два независимых ключа. Что при этом
хранится, написано в отдельном согласии, и спрашивается оно только у того, кто
привязывает.</p>

{{/* ОТСУТСТВИЕ записи и ЖИВАЯ запись — разные вещи, и Live их не различает:
     у нулевого ConsentRecord поле RevokedAt пусто, то есть Live честно
     отвечает «да» тому, кто ничего не подписывал. Спрашивается поэтому
     сперва сам факт подписи (GrantedAt), иначе строка про отзыв висела бы у
     каждого, кто мессенджер не привязывал вовсе. */}}
{{$bind := index .Have "binding"}}
{{if and (not $bind.GrantedAt.IsZero) $bind.Live (not .Bindings)}}
<p class="fine">Согласие на привязку дано, но ни один мессенджер не привязан.
<form method="post" action="/me/consent" class="avaform">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <input type="hidden" name="kind" value="binding">
  <input type="hidden" name="action" value="revoke">
  <button type="submit" class="danger">Отозвать согласие</button>
</form></p>
{{end}}

{{if .MailOn}}
<h2 class="sub">Переписка</h2>

{{/* ОТСУТСТВИЕ подписи и ЖИВАЯ подпись — разные вещи, и Live их не различает: у
     нулевого ConsentRecord поле RevokedAt пусто, то есть Live честно отвечает
     «да» тому, кто ничего не подписывал. Поэтому спрашивается сперва сам факт
     подписи (GrantedAt) — тот же довод, что у согласия на привязку выше. */}}
{{$talks := index .Have "talks"}}
{{if and (not $talks.GrantedAt.IsZero) $talks.Live}}
<p>Личные письма включены. <a href="/mail">Перейти к письмам</a>.</p>

<form method="post" action="/me/consent" class="avaform">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <input type="hidden" name="kind" value="talks">
  <input type="hidden" name="action" value="revoke">
  <button type="submit" class="danger">Отозвать согласие на переписку</button>
</form>

<p class="fine">Отзыв закрывает ВХОДЯЩИЕ: новых писем вам приносить не будут, и
тот, кто попробует написать, увидит отказ, а не тишину. Уже написанные письма
останутся лежать до конца срока хранения — стереть их раньше не вправе ни вы, ни
мы, и это не наше правило, а закон.</p>
{{else}}
<p>Личные письма выключены: согласия на переписку у нас от вас нет
{{- if not $talks.GrantedAt.IsZero}} (отозвано{{if $talks.RevokedAt}} {{when $talks.RevokedAt true}}{{end}}){{end}}.</p>

<p class="fine">Согласие необязательное, и без него площадка работает как
прежде: читать, писать заметки и отвечать в тредах можно и так. Включает оно
ровно одно — личные письма.</p>

<p><a class="btnlink" href="/mail/consent">Прочитать и включить</a></p>
{{end}}

{{/* Чёрный список показывается НЕЗАВИСИМО от согласия: закрытую переписку
     видно только отсюда — из списка писем она ушла, а на странице закрытого
     стои́т одна причина без кнопки, и отсылает она сюда же. Пустой список
     раздела не рисует вовсе. */}}
{{if .Blocked}}
<h2 class="sub">Закрытая переписка</h2>
<ul class="blocked">
{{range .Blocked}}
  <li>
    <b>{{.Nick}}</b> — писать вам не может.
    <form method="post" action="/mail/unblock" class="avaform">
      <input type="hidden" name="csrf" value="{{$.CSRF}}">
      <input type="hidden" name="to" value="{{.ID}}">
      <input type="hidden" name="back" value="/me">
      <button type="submit">Снять запрет</button>
    </form>
  </li>
{{end}}
</ul>

<p class="fine">Закрытый видит прямой отказ, а не тишину: площадка не делает
вид, что письмо ушло. Написанное им раньше остаётся у вас в переписке и лежит
до конца срока хранения — закрытие запрещает новые письма, а не стирает
прежние.</p>
{{end}}
{{end}}

<p class="fine">Пока вы заходите, эта сессия не истекает: срок отсчитывается от
последнего визита, а не от входа. Если вошли с чужого устройства и забыли выйти
— гасите все сессии разом.</p>

<form method="post" action="/me/logout-all" class="avaform">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <button type="submit" class="danger">Выйти на всех устройствах</button>
</form>

<h2 class="sub">Согласия</h2>
<ul class="consents">
{{range .Docs}}
  {{$rec := index $.Have .Kind}}
  <li class="consent">
    <div class="cname">{{.Title}}</div>
    {{if and $rec.GrantedAt.IsZero true}}{{end}}
    {{if $rec.Live}}
    <div class="fine">Дано {{when $rec.GrantedAt true}}{{if lt $rec.Version .Version}} · есть новая редакция{{end}}</div>
    <form method="post" action="/me/consent">
      <input type="hidden" name="csrf" value="{{$.CSRF}}">
      <input type="hidden" name="kind" value="{{.Kind}}">
      <input type="hidden" name="action" value="revoke">
      <button type="submit" class="danger">Отозвать</button>
    </form>
    {{else}}
    <div class="fine">Отозвано{{if $rec.RevokedAt}} {{when $rec.RevokedAt true}}{{end}}</div>
    <form method="post" action="/me/consent">
      <input type="hidden" name="csrf" value="{{$.CSRF}}">
      <input type="hidden" name="kind" value="{{.Kind}}">
      <input type="hidden" name="action" value="grant">
      <button type="submit">Дать снова</button>
    </form>
    {{end}}
  </li>
{{end}}
</ul>

<p class="fine">Отзыв согласия на распространение снимает ваше имя со всех ваших
заметок — немедленно и без очереди к модератору. Сами заметки и обсуждение под
ними остаются на площадке, а комментарии остаются подписанными. Отзыв общего
согласия делает то же и вдобавок закрывает вход: обрабатывать становится нечего.
Перед отзывом покажем, что именно произойдёт: вернуть подпись потом нельзя.</p>

<h2 class="sub">Что площадка о вас знает</h2>
<p class="fine">Номер анкеты, ник, аватар, пол и тексты ваших публикаций. Ни имени,
ни возраста, ни города, ни «о себе» С НГС здесь нет и не читается: оттуда берутся
только ник, фотография и пол. Город, занятие и рассказ о себе появляются, лишь
если вы напишете их ЗДЕСЬ сами, — и уходят вместе с отзывом того согласия.
IP-адреса не хранятся нигде, включая логи.</p>
<p class="fine">Обезличивание не удаляет тексты — удалить их, не разрушив чужие
разговоры, нельзя, — но снимает с них ваше имя, фото и связь с анкетой НГС.
Заметки обезличивает кнопка «Отозвать» выше: их у человека тысячи, и это
делается сразу. Полное обезличивание, вместе с комментариями, и выгрузку своих
данных делает администратор по вашему письму: у участника со 138 тысячами реплик
такой проход идёт около минуты, поэтому кнопкой он не сделан. Закон даёт
администратору на ответ 30 дней.</p>
{{end}}
