{{define "content"}}
<h1 class="ttl">Модерация</h1>

{{/* Сводка стоит первой и одной строкой, потому что она отвечает на
     единственный вопрос, который задают этой странице каждый день: «надо ли мне
     сейчас что-то делать». Цель — единицы строк в сутки; если очередь растёт
     быстрее, чем её читают, поднимать надо порог автомата, а не усердие. */}}
<p class="modsum">
  <span>Ждут решения: <b>{{.Stats.Review}}</b></span>
  <span>Скрыто автоматом: <b>{{.Stats.AutoHidden}}</b></span>
  <span>Просьб о пересмотре: <b>{{.Stats.Appeals}}</b></span>
  <span>Жалоб: <b>{{.Stats.Reports}}</b></span>
  <span class="fine">не проверено автоматом: {{.Stats.Unchecked}} · за сутки скрыто {{.Stats.HiddenDay}}</span>
  <a class="mlink" href="/mod/log">Журнал</a>
  {{if .Admin}}<a class="mlink" href="/mod/admin">Приглашения</a>{{end}}
</p>

<h2 class="sub">Ждут решения</h2>
{{if not .Queue}}
<p class="empty">Очередь пуста.</p>
{{end}}
<ul class="modq">
{{range .Queue}}
  <li class="mitem{{if .Hidden}} mhid{{end}}">
    <div class="mhead">
      {{/* У карточки человека (эпик M) заметки нет вовсе, и вести из очереди
           надо на его страницу: там она и показана целиком — рассказ, город,
           занятие и все снимки. */}}
      {{if eq .Subject.Kind "profile"}}
      <a class="mlink" href="/u/{{.Subject.ID}}">рассказ о себе {{.Subject.ID}}</a>
      {{else}}
      <a class="mlink" href="/n/{{.NoteID}}{{if not (eq .Subject.Kind "note")}}#c{{.Subject.ID}}{{end}}">
        {{if eq .Subject.Kind "note"}}заметка{{else}}комментарий{{end}} {{.Subject.ID}}</a>
      {{end}}
      {{if .AuthorID}}<a class="mlink" href="/u/{{.AuthorID}}">{{.AuthorNick}}</a>{{end}}
      <span class="fine">{{when .QueuedAt true}}</span>
      {{if .Appealed}}<span class="mtag warnbadge">просит пересмотра</span>{{end}}
      {{if .Hidden}}<span class="mtag">сейчас скрыто</span>{{end}}
    </div>
    {{if .Category}}
    <div class="mwhy">
      <b>{{.CategoryTitle}}</b>{{if .Reason}} — {{.Reason}}{{end}}
      {{if .ByMachine}}<span class="fine">автомат, {{.Model}}</span>{{else}}<span class="fine">человек</span>{{end}}
    </div>
    {{end}}
    {{if .Quote}}<blockquote class="mquote">{{.Quote}}</blockquote>{{end}}
    {{/* Картинка заметки. Автомат её не смотрит вовсе (он читает текст), а
         премодерации у картинок нет, — значит человек здесь единственный, кто
         её увидит. Миниатюрой: очередь обязана читаться за минуту. */}}
    {{if .ImageURL}}<a class="mshot" href="{{.ImageURL}}"><img src="{{.ImageURL}}" alt="Картинка заметки" loading="lazy"></a>{{end}}
    {{/* Фотографии профиля — здесь же и с кнопкой на КАЖДУЮ: вердикт очереди
         судит карточку целиком, а дурной бывает одна из трёх, и унести с нею
         рассказ значило бы наказать за то, чего не смотрели. */}}
    {{range .Photos}}
    <div class="mphoto">
      <a class="mshot" href="{{.URL}}"><img src="{{.URL}}" alt="Фотография участника" loading="lazy"></a>
      <form method="post" action="/mod/photo">
        <input type="hidden" name="csrf" value="{{$.CSRF}}">
        <input type="hidden" name="id" value="{{.ID}}">
        <input type="hidden" name="hide" value="{{if .Hidden}}0{{else}}1{{end}}">
        <button type="submit"{{if not .Hidden}} class="danger"{{end}}>
          {{if .Hidden}}Вернуть фотографию{{else}}Скрыть фотографию{{end}}</button>
      </form>
    </div>
    {{end}}
    {{range .Reports}}
    <div class="mrep">Жалоба{{if .Nick}} от {{.Nick}}{{end}}: {{if .Reason}}{{.Reason}}{{else}}без объяснения{{end}}</div>
    {{end}}
    <div class="mtext">{{.Body}}</div>
    {{template "moddec" (dec $ .)}}
  </li>
{{end}}
</ul>

{{if .Mail}}
{{/* ЖАЛОБЫ НА ПИСЬМА — свой список, а не строки общей очереди, и граница эта
     проходит по автомату: в очередь смотрит он, а переписку не видит вовсе.
     Здесь же видно, сколько модератор получает о письме: ник, время, цитату и
     причину — и ничего сверх. Открыть переписку ему нечем: такого действия нет
     ни в одном инструменте площадки. */}}
<h2 class="sub">Жалобы на письма</h2>
{{if not .MailReports}}
<p class="empty">Жалоб на письма нет.</p>
{{end}}
<ul class="modq">
{{range .MailReports}}
  <li class="mitem">
    <div class="mhead">
      <span class="lgsub">письмо {{.MessageID}}</span>
      <a class="mlink" href="/u/{{.AuthorID}}">{{.AuthorNick}}</a>
      <span class="fine">{{when .At true}}</span>
    </div>
    <div class="mrep">Жалоба от {{.ReporterNick}}: {{if .Reason}}{{.Reason}}{{else}}без объяснения{{end}}</div>
    {{/* ЦИТАТА-СНИМОК, снятая в момент жалобы. Плоским текстом: разбирать в
         обрезанном начале письма разметку значит рисовать то, чего в нём нет, —
         тот же довод, что у выдержки в списке переписок. */}}
    <blockquote class="mquote">{{ltplain .Quote}}</blockquote>
    <div class="mdec">
      {{/* Запрет писать стои́т НЕ здесь, а на странице автора, вместе с
           остальными решениями о людях: второе место для одной и той же кнопки
           однажды разойдётся с первым. */}}
      <a class="mlink" href="/u/{{.AuthorID}}">Решения об этом участнике</a>
      <form method="post" action="/mod/mail">
        <input type="hidden" name="csrf" value="{{$.CSRF}}">
        <input type="hidden" name="report" value="{{.ID}}">
        <input type="hidden" name="back" value="/mod">
        <input type="text" name="reason" maxlength="500" placeholder="Что решили (необязательно)">
        <button type="submit">Разобрано</button>
      </form>
    </div>
  </li>
{{end}}
</ul>
{{end}}

{{/* Второй список — не работа, а КОНТРОЛЬ над машиной: модератор обязан иметь
     возможность пробежать её решения глазами, не дожидаясь, пока обиженный
     автор нажмёт «на пересмотр». */}}
<h2 class="sub">Скрыто автоматом</h2>
{{if not .AutoHidden}}
<p class="empty">Автомат пока ничего не скрывал.</p>
{{end}}
<ul class="modq">
{{range .AutoHidden}}
  <li class="mitem mhid">
    <div class="mhead">
      {{/* У карточки человека (эпик M) заметки нет вовсе, и вести из очереди
           надо на его страницу: там она и показана целиком — рассказ, город,
           занятие и все снимки. */}}
      {{if eq .Subject.Kind "profile"}}
      <a class="mlink" href="/u/{{.Subject.ID}}">рассказ о себе {{.Subject.ID}}</a>
      {{else}}
      <a class="mlink" href="/n/{{.NoteID}}{{if not (eq .Subject.Kind "note")}}#c{{.Subject.ID}}{{end}}">
        {{if eq .Subject.Kind "note"}}заметка{{else}}комментарий{{end}} {{.Subject.ID}}</a>
      {{end}}
      {{if .AuthorID}}<a class="mlink" href="/u/{{.AuthorID}}">{{.AuthorNick}}</a>{{end}}
      <span class="fine">{{if .CheckedAt}}{{when .CheckedAt true}}{{end}}</span>
      {{if .Appealed}}<span class="mtag warnbadge">просит пересмотра</span>{{end}}
    </div>
    <div class="mwhy">
      <b>{{.CategoryTitle}}</b>{{if .Reason}} — {{.Reason}}{{end}}
      <span class="fine">{{.Model}}</span>
    </div>
    {{if .Quote}}<blockquote class="mquote">{{.Quote}}</blockquote>{{end}}
    {{/* Картинка заметки. Автомат её не смотрит вовсе (он читает текст), а
         премодерации у картинок нет, — значит человек здесь единственный, кто
         её увидит. Миниатюрой: очередь обязана читаться за минуту. */}}
    {{if .ImageURL}}<a class="mshot" href="{{.ImageURL}}"><img src="{{.ImageURL}}" alt="Картинка заметки" loading="lazy"></a>{{end}}
    {{/* Фотографии профиля — здесь же и с кнопкой на КАЖДУЮ: вердикт очереди
         судит карточку целиком, а дурной бывает одна из трёх, и унести с нею
         рассказ значило бы наказать за то, чего не смотрели. */}}
    {{range .Photos}}
    <div class="mphoto">
      <a class="mshot" href="{{.URL}}"><img src="{{.URL}}" alt="Фотография участника" loading="lazy"></a>
      <form method="post" action="/mod/photo">
        <input type="hidden" name="csrf" value="{{$.CSRF}}">
        <input type="hidden" name="id" value="{{.ID}}">
        <input type="hidden" name="hide" value="{{if .Hidden}}0{{else}}1{{end}}">
        <button type="submit"{{if not .Hidden}} class="danger"{{end}}>
          {{if .Hidden}}Вернуть фотографию{{else}}Скрыть фотографию{{end}}</button>
      </form>
    </div>
    {{end}}
    <div class="mtext">{{.Body}}</div>
    {{template "moddec" (dec $ .)}}
  </li>
{{end}}
</ul>
{{end}}

{{/* Две кнопки решения. Без экрана подтверждения: скрытие обратимо, а лишнее
     нажатие в пересчёте на сутки дороже ошибки. Поле причины одно на строку и
     необязательно — обязательная причина превращается в «ыы» через неделю. */}}
{{define "moddec"}}
<form method="post" action="/mod/act" class="mdec">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <input type="hidden" name="back" value="{{.Back}}">
  <input type="hidden" name="kind" value="{{.Subject.Kind}}">
  <input type="hidden" name="id" value="{{.Subject.ID}}">
  <input class="mreason" name="reason" maxlength="500" placeholder="Причина (увидит автор)">
  <button type="submit" name="do" value="keep" class="mbtn">Оставить</button>
  <button type="submit" name="do" value="drop" class="mbtn danger">Скрыть</button>
</form>
{{end}}
