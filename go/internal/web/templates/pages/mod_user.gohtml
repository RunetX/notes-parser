{{define "content"}}
{{$m := .Member}}
<h1 class="ttl">{{if $m.Nick}}{{$m.Nick}}{{else}}Участник №{{$m.ID}}{{end}}</h1>
<p class="fine">
  {{if lt $m.ID 100000000000}}анкета НГС №{{$m.ID}}{{else}}участник №{{$m.ID}}{{end}}
  · {{if eq $m.Kind 1}}вошёл{{else if eq $m.Kind 2}}служебный{{else}}тень зеркала{{end}}
  {{if eq $m.Role 1}} · модератор{{else if eq $m.Role 2}} · администратор{{end}}
  {{if $m.AnonymizedAt}} · обезличен{{end}}
  · <a class="mlink" href="/mod">к очереди</a>
</p>

{{if .Banned}}
<p class="warn">Публикации запрещены до {{when $m.BannedUntil true}}.
{{if $m.BanReason}}Причина: {{$m.BanReason}}{{end}}</p>
<form method="post" action="/mod/u/{{$m.ID}}" class="mdec">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <input type="hidden" name="back" value="{{.Back}}">
  <input class="mreason" name="reason" maxlength="500" placeholder="Почему снимаем">
  <button type="submit" name="do" value="unban" class="mbtn">Снять запрет</button>
</form>
{{else}}
{{/* Запрет писать, а не выход из учётной записи: чтение на площадке открыто
     всем, и выкинув человека, мы отняли бы у него ровно ту страницу, где
     написано, за что и до какого числа. Тридцать суток по умолчанию — не наша
     выдумка, ровно такой срок ставит НГС. */}}
<form method="post" action="/mod/u/{{$m.ID}}" class="mdec">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <input type="hidden" name="back" value="{{.Back}}">
  <label class="fine" for="days">Суток</label>
  <input id="days" class="mdays" name="days" type="number" min="1" max="365" value="30">
  <input class="mreason" name="reason" maxlength="500" placeholder="Причина (увидит он сам)">
  <button type="submit" name="do" value="ban" class="mbtn danger">Запретить писать</button>
</form>
{{end}}

{{if .Admin}}
<h2 class="sub">Права</h2>
<form method="post" action="/mod/u/{{$m.ID}}" class="mdec">
  <input type="hidden" name="csrf" value="{{.CSRF}}">
  <input type="hidden" name="back" value="{{.Back}}">
  <select name="role" class="mrole">
    <option value="user"{{if eq $m.Role 0}} selected{{end}}>участник</option>
    <option value="moderator"{{if eq $m.Role 1}} selected{{end}}>модератор</option>
    <option value="admin"{{if eq $m.Role 2}} selected{{end}}>администратор</option>
  </select>
  <button type="submit" name="do" value="role" class="mbtn">Назначить</button>
</form>
<p class="fine">Право скрывать чужие слова выдаёт только администратор, и выдача
пишется в журнал: «кто дал» — часть этого права.</p>
{{end}}

<p class="fine">Обезличивание и выгрузку данных по требованию человека делает
администратор командой на сервере: обе операции проходят по всем его публикациям
разом и в срок веб-запроса не укладываются, а обезличивание вдобавок необратимо.</p>
{{end}}
