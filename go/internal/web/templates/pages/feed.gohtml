{{define "content"}}
<div class="feedhead">
  <h1 class="ttl">Общая лента</h1>
  {{if .CanWrite}}<a class="newnote" href="/new">Написать заметку</a>{{end}}
</div>

{{template "pager" .Pager}}

{{if not .Notes}}
<p class="empty">Пока пусто.</p>
{{end}}

<ul class="notes">
{{range .Notes}}
  <li class="note{{if .Pinned}} pinned{{end}}">
    {{/* Автор — колонка слева: квадратный аватар, ник под ним. Ровно как на
         НГС; это первое, по чему постоянный читатель узнаёт страницу. */}}
    <div class="author">
      {{template "avatar" (av .Author.AvatarURL .Author.Gender .Anonymous)}}
      <span class="nick {{.Author.Gender.Class}}{{if .Anonymous}} anon{{end}}">{{.Name}}</span>
    </div>
    <div class="nbody">
      {{/* Текст заметки показывается ЦЕЛИКОМ, без «читать дальше»: на НГС
           лента так и устроена, её листают, а не раскрывают. */}}
      {{/* Метка закрепления — на самой заметке, а не над блоком: закреплённые
           стоят в общем списке, и без метки старая запись наверху читается как
           поломка сортировки. */}}
      {{if .Pinned}}<p class="pin">Закреплено</p>{{end}}
      <div class="text">{{body .}}</div>
      <div class="nfoot">
        {{when .PublishedAt .PublishedExact}}
        {{/* Закрытое обсуждение показывается ТОЙ ЖЕ надписью, что и отметка НГС
             «не актуальна»: для читателя оба состояния значат одно — заглянуть
             можно, вступить нельзя, — и заводить ради нашего замка вторую
             формулировку значило бы объяснять человеку разницу между чужой
             отметкой и нашим решением. Разница есть, но она про право писать, а
             не про то, что видно в ленте. */}}
        {{if or .CommentsClosed .Locked}}
        <a class="clink" href="/n/{{.ID}}">Заметка не актуальна, но вы можете ознакомиться с её обсуждением <span class="cnt">{{.CommentCount}}</span></a>
        {{else}}
        <a class="clink" href="/n/{{.ID}}">Комментарии <span class="cnt">{{.CommentCount}}</span></a>
        {{end}}
        {{/* «Добавить комментарий» — вход в разговор прямо из ленты, как на НГС
             у вошедшего. Гостю его там нет вовсе, и у нас нет: ссылка, ведущая
             к отказу, хуже её отсутствия. Замок снимает её и у вошедшего —
             отметка «не актуальна» не снимает, потому что писать она не
             запрещает (это чужая метка, и стоит она у 62 % зеркальных заметок). */}}
        {{if and $.CanWrite (not .Locked)}}
        <a class="addc" href="/n/{{.ID}}#reply">Добавить комментарий</a>
        {{end}}
      </div>
    </div>
  </li>
{{end}}
</ul>

{{template "pager" .Pager}}
{{end}}
