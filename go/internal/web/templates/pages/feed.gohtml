{{define "content"}}
<div class="feedhead">
  <h1 class="ttl">Лента</h1>
  {{if .CanWrite}}<a class="newnote" href="/new">Написать заметку</a>{{end}}
</div>

{{/* Заметка ушла НА САЙТ, а не сюда: у человека стоит галочка, и своей строки
     у неё нет вовсе — приедет она зеркалом. Сказать об этом обязательно:
     полторы минуты между нажатием и появлением иначе читаются как пропажа
     текста. Строка живёт один показ и берётся из адреса, а не из базы. */}}
{{if .SentToNGS}}
<p class="warn">Заметка отправлена на love.ngs.ru — она появится здесь сама,
примерно через минуту, вместе со своим обсуждением. Отвечать на неё можно будет
и там, и тут: реплики ходят в обе стороны.</p>
{{end}}

{{template "pager" .Pager}}

{{if not .Notes}}
<p class="empty">Пока пусто.</p>
{{end}}

<ul class="notes"
    {{- if .FreshOK}} data-fresh="{{.FreshAfter}}" data-fresh-url="/fresh"{{end}}>
{{range .Notes}}
  {{template "note_item" (ni $ .)}}
{{end}}
</ul>

{{template "pager" .Pager}}
{{end}}
