{{define "content"}}
<div class="feedhead">
  <h1 class="ttl">Общая лента</h1>
  {{if .CanWrite}}<a class="newnote" href="/new">Написать заметку</a>{{end}}
</div>

{{template "pager" .Pager}}

{{if not .Notes}}
<p class="empty">Пока пусто.</p>
{{end}}

<ul class="notes"
    {{- if .FreshOK}} data-fresh="{{.FreshAfter}}" data-fresh-url="/fresh"{{end}}>
{{range .Notes}}
  {{template "note_item" (ni $ .)}}
{{end}}
</ul>

{{template "pager" .Pager}}
{{end}}
