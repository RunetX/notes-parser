{{define "content"}}
<div class="feedhead">
  <h1 class="ttl">Общая лента</h1>
  {{if .CanWrite}}<a class="newnote" href="/new">Написать заметку</a>{{end}}
</div>

{{template "pager" .Pager}}

{{if not .Notes}}
<p class="empty">Пока пусто.</p>
{{end}}

<ul class="notes">
{{range .Notes}}
  <li class="note">
    {{/* Автор — колонка слева: квадратный аватар, ник под ним. Ровно как на
         НГС; это первое, по чему постоянный читатель узнаёт страницу. */}}
    <div class="author">
      {{template "avatar" (av .Author.AvatarURL .Name)}}
      <span class="nick {{.Author.Gender.Class}}{{if .Anonymous}} anon{{end}}">{{.Name}}</span>
    </div>
    <div class="nbody">
      {{/* Текст заметки показывается ЦЕЛИКОМ, без «читать дальше»: на НГС
           лента так и устроена, её листают, а не раскрывают. */}}
      <div class="text">{{body .Body}}</div>
      <div class="nfoot">
        {{when .PublishedAt .PublishedExact}}
        {{if .CommentsClosed}}
        <a class="clink" href="/n/{{.ID}}">Заметка не актуальна, но вы можете ознакомиться с её обсуждением <span class="cnt">{{.CommentCount}}</span></a>
        {{else}}
        <a class="clink" href="/n/{{.ID}}">Комментарии <span class="cnt">{{.CommentCount}}</span></a>
        {{end}}
      </div>
    </div>
  </li>
{{end}}
</ul>

{{template "pager" .Pager}}
{{end}}
